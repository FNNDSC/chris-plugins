{
  "name": "pl-reg_chxr",
  "version": "1.2.1",
  "dock_image": "ghcr.io/fnndsc/pl-reg_chxr:1.2.1",
  "public_repo": "https://github.com/fnndsc/pl-reg_chxr",
  "type": "ds",
  "title": "A ChRIS plugin to verify PACS file registration in CUBE",
  "category": "",
  "description": "A plugin to wait till a particular set of PACS files are registered to a CUBE instance",
  "documentation": "https://github.com/FNNDSC/pl-reg_",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "reg_chxr",
  "max_number_of_workers": 1,
  "min_memory_limit": "100Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "PFDCMurl",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--PFDCMurl",
      "short_flag": "--PFDCMurl",
      "action": "store",
      "help": "endpoint URL of pfdcm",
      "ui_exposed": true
    },
    {
      "name": "PACSname",
      "type": "str",
      "optional": true,
      "default": "MINICHRISORTHANC",
      "flag": "--PACSname",
      "short_flag": "--PACSname",
      "action": "store",
      "help": "name of the PACS",
      "ui_exposed": true
    },
    {
      "name": "CUBEurl",
      "type": "str",
      "optional": true,
      "default": "http://localhost:8000/api/v1/",
      "flag": "--CUBEurl",
      "short_flag": "--CUBEurl",
      "action": "store",
      "help": "CUBE URL",
      "ui_exposed": true
    },
    {
      "name": "pluginInstanceID",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--pluginInstanceID",
      "short_flag": "--pluginInstanceID",
      "action": "store",
      "help": "plugin instance ID from which to start analysis",
      "ui_exposed": true
    },
    {
      "name": "CUBEtoken",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--CUBEtoken",
      "short_flag": "--CUBEtoken",
      "action": "store",
      "help": "CUBE/ChRIS auth token",
      "ui_exposed": true
    },
    {
      "name": "inputJSONfile",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--inputJSONfile",
      "short_flag": "--inputJSONfile",
      "action": "store",
      "help": "JSON file containing DICOM data to be retrieved",
      "ui_exposed": true
    },
    {
      "name": "tagStruct",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--tagStruct",
      "short_flag": "--tagStruct",
      "action": "store",
      "help": "directive to use to anonymize DICOMs",
      "ui_exposed": true
    },
    {
      "name": "preserveTags",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--preserveTags",
      "short_flag": "--preserveTags",
      "action": "store",
      "help": "Stringified JSON of tags and values to preserve",
      "ui_exposed": true
    },
    {
      "name": "pollInterval",
      "type": "int",
      "optional": true,
      "default": 5,
      "flag": "--pollInterval",
      "short_flag": "--pollInterval",
      "action": "store",
      "help": "wait time in seconds before the next poll",
      "ui_exposed": true
    },
    {
      "name": "maxPoll",
      "type": "int",
      "optional": true,
      "default": 50,
      "flag": "--maxPoll",
      "short_flag": "--maxPoll",
      "action": "store",
      "help": "max number of times to poll before error out",
      "ui_exposed": true
    },
    {
      "name": "orthancUrl",
      "type": "str",
      "optional": true,
      "default": "http://0.0.0.0:8042",
      "flag": "--orthancUrl",
      "short_flag": "--orthancUrl",
      "action": "store",
      "help": "Orthanc server url",
      "ui_exposed": true
    },
    {
      "name": "orthancUsername",
      "type": "str",
      "optional": true,
      "default": "orthanc",
      "flag": "--orthancUsername",
      "short_flag": "--orthancUsername",
      "action": "store",
      "help": "Orthanc server username",
      "ui_exposed": true
    },
    {
      "name": "orthancPassword",
      "type": "str",
      "optional": true,
      "default": "orthanc",
      "flag": "--orthancPassword",
      "short_flag": "--orthancPassword",
      "action": "store",
      "help": "Orthanc server password",
      "ui_exposed": true
    },
    {
      "name": "pushToRemote",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--pushToRemote",
      "short_flag": "--pushToRemote",
      "action": "store",
      "help": "Remote modality",
      "ui_exposed": true
    },
    {
      "name": "inNode",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--inNode",
      "short_flag": "--inNode",
      "action": "store_true",
      "help": "perform in-node implicit parallelization in conjunction with --thread",
      "ui_exposed": true
    },
    {
      "name": "thread",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--thread",
      "short_flag": "--thread",
      "action": "store_true",
      "help": "use threading to branch in parallel",
      "ui_exposed": true
    },
    {
      "name": "recipients",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--recipients",
      "short_flag": "--recipients",
      "action": "store",
      "help": "comma separated valid email recipient addresses",
      "ui_exposed": true
    },
    {
      "name": "SMTPServer",
      "type": "str",
      "optional": true,
      "default": "mailsmtp4.childrenshospital.org",
      "flag": "--SMTPServer",
      "short_flag": "--SMTPServer",
      "action": "store",
      "help": "valid email server",
      "ui_exposed": true
    },
    {
      "name": "dicomFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--dicomFilter",
      "short_flag": "--dicomFilter",
      "action": "store",
      "help": "comma separated dicom tags with values",
      "ui_exposed": true
    },
    {
      "name": "imgCount",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--imgCount",
      "short_flag": "--imgCount",
      "action": "store",
      "help": "comma separated image count filter expression.",
      "ui_exposed": true
    }
  ]
}
