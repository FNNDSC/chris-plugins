{
  "name": "pl-images-register",
  "version": "1.0.1",
  "dock_image": "ghcr.io/fnndsc/pl-images-register:1.0.1",
  "public_repo": "https://github.com/fnndsc/pl-images-register",
  "type": "ds",
  "title": "Multiple image registration",
  "category": "",
  "description": "A ChRIS plugin to do multiple image registration",
  "documentation": "https://github.com/FNNDSC/pl-images-regi",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <arman.avasta@childrens.harvard.edu>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "images_register",
  "max_number_of_workers": 1,
  "min_memory_limit": "100Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "word",
      "type": "str",
      "optional": false,
      "default": null,
      "flag": "--word",
      "short_flag": "-w",
      "action": "store",
      "help": "word to count",
      "ui_exposed": true
    },
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*.txt",
      "flag": "--pattern",
      "short_flag": "-p",
      "action": "store",
      "help": "input file filter glob",
      "ui_exposed": true
    }
  ]
}
