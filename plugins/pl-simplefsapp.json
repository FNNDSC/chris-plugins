{
  "name": "pl-simplefsapp",
  "version": "1.0.1",
  "dock_image": "ghcr.io/fnndsc/pl-simplefsapp:1.0.1",
  "public_repo": "https://github.com/FNNDSC/pl-simplefsapp",
  "type": "fs",
  "title": "Simple ChRIS fs app",
  "category": "copy",
  "description": "A simple ChRIS fs app demo",
  "documentation": "http://wiki",
  "license": "MIT",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "simplefsapp",
  "max_number_of_workers": 1,
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "dir",
      "type": "path",
      "optional": false,
      "default": null,
      "flag": "--dir",
      "short_flag": "--dir",
      "action": "store",
      "help": "look up directory",
      "ui_exposed": true
    },
    {
      "name": "sleepLength",
      "type": "int",
      "optional": true,
      "default": 0,
      "flag": "--sleepLength",
      "short_flag": "--sleepLength",
      "action": "store",
      "help": "time to sleep before performing plugin action",
      "ui_exposed": true
    }
  ]
}
