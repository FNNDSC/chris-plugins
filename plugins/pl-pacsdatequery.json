{
  "name": "pl-pacsdatequery",
  "version": "1.0.0",
  "dock_image": "ghcr.io/fnndsc/pl-pacsdatequery:latest",
  "public_repo": "https://github.com/fnndsc/pl-pacsdatequery",
  "type": "ds",
  "title": "A ChRIS PACS Query Plugin",
  "description": "A ChRIS PACS Plugin to query a PACS and store its responses in JSON format",
  "documentation": "https://github.com/FNNDSC/pl-pacsdatequery",
  "license": "MIT",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "pacsdatequery",
  "max_number_of_workers": 1,
  "min_memory_limit": "100Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "word",
      "type": "str",
      "optional": false,
      "default": null,
      "flag": "--word",
      "short_flag": "-w",
      "action": "store",
      "help": "word to count",
      "ui_exposed": true
    },
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*.txt",
      "flag": "--pattern",
      "short_flag": "-p",
      "action": "store",
      "help": "input file filter glob",
      "ui_exposed": true
    }
  ]
}
