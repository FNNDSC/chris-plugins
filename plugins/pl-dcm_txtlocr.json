{
  "name": "pl-dcm_txtlocr",
  "version": "1.1.5",
  "dock_image": "ghcr.io/fnndsc/pl-dcm_txtlocr:1.1.5",
  "public_repo": "https://github.com/fnndsc/pl-dcm_txtlocr",
  "type": "ds",
  "title": "A ChRIS plugin to detect text in a DICOM file",
  "category": "",
  "description": "A ChRIS plugin to do something awesome",
  "documentation": "https://github.com/FNNDSC/pl-dcm_txtlocr",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python3.10",
  "selfpath": "/usr/local/bin",
  "selfexec": "dcm_txtlocr",
  "max_number_of_workers": 1,
  "min_cpu_limit": "2000m",
  "min_memory_limit": "2000Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "textOutputDir",
      "type": "str",
      "optional": true,
      "default": "text_data",
      "flag": "--textOutputDir",
      "short_flag": "-o",
      "action": "store",
      "help": "Comma separated DICOM tags",
      "ui_exposed": true
    },
    {
      "name": "fileFilter",
      "type": "str",
      "optional": true,
      "default": "dcm",
      "flag": "--fileFilter",
      "short_flag": "-f",
      "action": "store",
      "help": "input file filter glob",
      "ui_exposed": true
    },
    {
      "name": "outputType",
      "type": "str",
      "optional": true,
      "default": "dcm",
      "flag": "--outputType",
      "short_flag": "-t",
      "action": "store",
      "help": "output file type(extension only)",
      "ui_exposed": true
    },
    {
      "name": "useGpu",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--useGpu",
      "short_flag": "-u",
      "action": "store_true",
      "help": "If specified, use available gpu",
      "ui_exposed": true
    }
  ]
}
