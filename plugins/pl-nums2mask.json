{
  "name": "pl-nums2mask",
  "version": "2.0.1",
  "dock_image": "ghcr.io/fnndsc/pl-nums2mask:2.0.1",
  "public_repo": "https://github.com/FNNDSC/pl-nums2mask",
  "type": "ds",
  "title": "Create Brain Mask from Segmentation",
  "category": "MRI Processing",
  "description": "Create brain mask from segmentation",
  "documentation": "https://github.com/FNNDSC/pl-nums2mask",
  "license": "MIT",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "nums2mask",
  "max_number_of_workers": 1,
  "min_memory_limit": "500Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "mask",
      "type": "str",
      "optional": false,
      "default": null,
      "flag": "--mask",
      "short_flag": "-m",
      "action": "store",
      "help": "List of output file names and voxel values to include,e.g. \"wm_left.mnc:5,161 wm_right.mnc:4,160\"",
      "ui_exposed": true
    },
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*.mnc",
      "flag": "--pattern",
      "short_flag": "-p",
      "action": "store",
      "help": "pattern for file names to include",
      "ui_exposed": true
    }
  ]
}
