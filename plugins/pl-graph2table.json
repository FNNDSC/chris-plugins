{
  "name": "pl-graph2table",
  "version": "0.2.0",
  "dock_image": "ghcr.io/fnndsc/pl-graph2table:0.2.0",
  "public_repo": "https://github.com/FNNDSC/pl-graph2table",
  "type": "ds",
  "title": "A ChRIS plugin app",
  "description": "An app to convert a graphical representation of a tree to a tabular representation",
  "documentation": "http://wiki",
  "license": "MIT",
  "authors": "Sandip Samal <sandip.samal@childrens.harvard.edu>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "graph2table",
  "max_number_of_workers": 1,
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "comment",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--comment",
      "short_flag": "--comment",
      "action": "store",
      "help": "a simple string to print",
      "ui_exposed": true
    }
  ]
}
