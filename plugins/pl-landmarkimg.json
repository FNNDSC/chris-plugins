{
  "name": "pl-landmarkimg",
  "version": "1.0.8",
  "dock_image": "ghcr.io/fnndsc/pl-landmarkimg:1.0.8",
  "public_repo": "https://github.com/fnndsc/pl-landmarkimg",
  "type": "ds",
  "title": "A ChRIS plugin for marking anatomical landmarks",
  "category": "",
  "description": "A ChRIS plugin for marking anatomical landmarks and alignment lines on Leg X-ray images",
  "documentation": "https://github.com/FNNDSC/pl-landmarkimg",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "landmarkimg",
  "max_number_of_workers": 1,
  "min_cpu_limit": "4000m",
  "min_memory_limit": "4000Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "inputJsonName",
      "type": "str",
      "optional": true,
      "default": "prediction.json",
      "flag": "-j",
      "short_flag": "-j",
      "action": "store",
      "help": "Input JSON file name",
      "ui_exposed": true
    },
    {
      "name": "inputImageName",
      "type": "str",
      "optional": true,
      "default": "leg.png",
      "flag": "-i",
      "short_flag": "-i",
      "action": "store",
      "help": "Name of the input image file",
      "ui_exposed": true
    },
    {
      "name": "pointMarker",
      "type": "str",
      "optional": true,
      "default": "x",
      "flag": "-p",
      "short_flag": "-p",
      "action": "store",
      "help": "Point marker",
      "ui_exposed": true
    },
    {
      "name": "pointColor",
      "type": "str",
      "optional": true,
      "default": "red",
      "flag": "-c",
      "short_flag": "-c",
      "action": "store",
      "help": "Color of point marker",
      "ui_exposed": true
    },
    {
      "name": "lineColor",
      "type": "str",
      "optional": true,
      "default": "red",
      "flag": "-l",
      "short_flag": "-l",
      "action": "store",
      "help": "Color of the line to be drawn",
      "ui_exposed": true
    },
    {
      "name": "lineWidth",
      "type": "int",
      "optional": true,
      "default": 1,
      "flag": "-w",
      "short_flag": "-w",
      "action": "store",
      "help": "Width of lines on image",
      "ui_exposed": true
    },
    {
      "name": "pointSize",
      "type": "int",
      "optional": true,
      "default": 10,
      "flag": "-z",
      "short_flag": "-z",
      "action": "store",
      "help": "The size of points to be plotted on the image",
      "ui_exposed": true
    },
    {
      "name": "outputImageExtension",
      "type": "str",
      "optional": true,
      "default": "jpg",
      "flag": "--outputImageExtension",
      "short_flag": "--outputImageExtension",
      "action": "store",
      "help": "Generated output image file extension,default value is jpg",
      "ui_exposed": true
    },
    {
      "name": "addTextPos",
      "type": "str",
      "optional": true,
      "default": "top",
      "flag": "-q",
      "short_flag": "-q",
      "action": "store",
      "help": "Position of text placement on an input image; top or bottom",
      "ui_exposed": true
    },
    {
      "name": "addText",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--addText",
      "short_flag": "--addText",
      "action": "store",
      "help": "optional text to add on the final image",
      "ui_exposed": true
    },
    {
      "name": "addTextSize",
      "type": "float",
      "optional": true,
      "default": 5.0,
      "flag": "--addTextSize",
      "short_flag": "--addTextSize",
      "action": "store",
      "help": "Size of additional text on the final output,default value is 5.0",
      "ui_exposed": true
    },
    {
      "name": "addTextColor",
      "type": "str",
      "optional": true,
      "default": "white",
      "flag": "--addTextColor",
      "short_flag": "--addTextColor",
      "action": "store",
      "help": "Color of additional text on the final output,default value is white",
      "ui_exposed": true
    }
  ]
}
