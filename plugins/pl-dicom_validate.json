{
  "name": "pl-dicom_validate",
  "version": "1.0.0",
  "dock_image": "ghcr.io/fnndsc/pl-dicom_validate:latest",
  "public_repo": "https://github.com/fnndsc/pl-dicom_validate",
  "type": "ds",
  "title": "A ChRIS plugin to validate DICOMs",
  "description": "A ChRIS plugin to validate DICOMs.",
  "documentation": "https://github.com/FNNDSC/pl-dicom_validate",
  "license": "MIT",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "dicom_validate",
  "max_number_of_workers": 1,
  "min_memory_limit": "100Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*.dcm",
      "flag": "--pattern",
      "short_flag": "-p",
      "action": "store",
      "help": "input file filter glob",
      "ui_exposed": true
    }
  ]
}
