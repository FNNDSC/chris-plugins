{
  "name": "pl-pfdorun",
  "version": "2.2.17",
  "dock_image": "ghcr.io/fnndsc/pl-pfdorun:2.2.17",
  "public_repo": "https://github.com/FNNDSC/pl-pfdorun",
  "type": "ds",
  "title": "A ChRIS plugin app",
  "category": "",
  "description": "The pl-pfdorun plugin is a general purpose \"swiss army\" knife DS plugin that can be used to execute some CLI type commands on input directories.",
  "documentation": "https://github.com/FNNDSC/pl-pfdorun",
  "license": "MIT",
  "icon": "",
  "authors": "Rudolph Pienaar <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python3.9",
  "selfpath": "/usr/local/bin",
  "selfexec": "pfdorun",
  "max_number_of_workers": 1,
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "inputFile",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--inputFile",
      "short_flag": "-i",
      "action": "store",
      "help": "input file",
      "ui_exposed": true
    },
    {
      "name": "exec",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--exec",
      "short_flag": "-e",
      "action": "store",
      "help": "command line execution string to perform",
      "ui_exposed": true
    },
    {
      "name": "fileFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--fileFilter",
      "short_flag": "-f",
      "action": "store",
      "help": "a list of comma separated string filters to apply across the input file space",
      "ui_exposed": true
    },
    {
      "name": "dirFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--dirFilter",
      "short_flag": "-d",
      "action": "store",
      "help": "a list of comma separated string filters to apply across the input dir space",
      "ui_exposed": true
    },
    {
      "name": "analyzeFileIndex",
      "type": "str",
      "optional": true,
      "default": "-1",
      "flag": "--analyzeFileIndex",
      "short_flag": "--analyzeFileIndex",
      "action": "store",
      "help": "file index per directory to analyze",
      "ui_exposed": true
    },
    {
      "name": "printElapsedTime",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--printElapsedTime",
      "short_flag": "--printElapsedTime",
      "action": "store_true",
      "help": "print program run time",
      "ui_exposed": true
    },
    {
      "name": "threads",
      "type": "str",
      "optional": true,
      "default": "0",
      "flag": "--threads",
      "short_flag": "--threads",
      "action": "store",
      "help": "number of threads for innermost loop processing",
      "ui_exposed": true
    },
    {
      "name": "outputLeafDir",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--outputLeafDir",
      "short_flag": "--outputLeafDir",
      "action": "store",
      "help": "formatting spec for output leaf directory",
      "ui_exposed": true
    },
    {
      "name": "test",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--test",
      "short_flag": "--test",
      "action": "store_true",
      "help": "test",
      "ui_exposed": true
    },
    {
      "name": "noJobLogging",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--noJobLogging",
      "short_flag": "--noJobLogging",
      "action": "store_true",
      "help": "Turn off per-job logging to file system",
      "ui_exposed": true
    },
    {
      "name": "synopsis",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--synopsis",
      "short_flag": "-y",
      "action": "store_true",
      "help": "short synopsis",
      "ui_exposed": true
    },
    {
      "name": "overwrite",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--overwrite",
      "short_flag": "--overwrite",
      "action": "store_true",
      "help": "overwrite files if already existing",
      "ui_exposed": true
    },
    {
      "name": "followLinks",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--followLinks",
      "short_flag": "--followLinks",
      "action": "store_true",
      "help": "follow symbolic links",
      "ui_exposed": true
    },
    {
      "name": "verbose",
      "type": "str",
      "optional": true,
      "default": "1",
      "flag": "--verbose",
      "short_flag": "--verbose",
      "action": "store",
      "help": "verbosity level for app",
      "ui_exposed": true
    },
    {
      "name": "syslog",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--syslog",
      "short_flag": "--syslog",
      "action": "store_true",
      "help": "show outputs in syslog style",
      "ui_exposed": true
    },
    {
      "name": "maxDepth",
      "type": "str",
      "optional": true,
      "default": "-1",
      "flag": "--maxDepth",
      "short_flag": "--maxDepth",
      "action": "store",
      "help": "max depth, counting from zero, to descend",
      "ui_exposed": true
    }
  ]
}
