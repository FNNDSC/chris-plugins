{
  "name": "pl-superlink",
  "version": "0.1.7",
  "dock_image": "ghcr.io/fnndsc/pl-superlink:0.1.7",
  "public_repo": "https://github.com/fnndsc/pl-superlink",
  "type": "ds",
  "title": "FedMed Flower SuperLink",
  "category": "Federated Learning",
  "description": "Flower-based coordinator ChRIS plugin",
  "documentation": "https://github.com/FNNDSC/pl-superlink",
  "license": "MIT",
  "icon": "",
  "authors": "FedMed BU Team <rpsmith@bu.edu>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "fedmed-pl-superlink",
  "max_number_of_workers": 1,
  "min_memory_limit": "8192Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "rounds",
      "type": "int",
      "optional": true,
      "default": 3,
      "flag": "--rounds",
      "short_flag": "--rounds",
      "action": "store",
      "help": "federated rounds to run",
      "ui_exposed": true
    },
    {
      "name": "total_clients",
      "type": "int",
      "optional": true,
      "default": 3,
      "flag": "--total-clients",
      "short_flag": "--total-clients",
      "action": "store",
      "help": "expected number of SuperNodes",
      "ui_exposed": true
    },
    {
      "name": "local_epochs",
      "type": "int",
      "optional": true,
      "default": 10,
      "flag": "--local-epochs",
      "short_flag": "--local-epochs",
      "action": "store",
      "help": "local epochs per round",
      "ui_exposed": true
    },
    {
      "name": "learning_rate",
      "type": "float",
      "optional": true,
      "default": 0.2,
      "flag": "--learning-rate",
      "short_flag": "--learning-rate",
      "action": "store",
      "help": "client learning rate",
      "ui_exposed": true
    },
    {
      "name": "data_seed",
      "type": "int",
      "optional": true,
      "default": 13,
      "flag": "--data-seed",
      "short_flag": "--data-seed",
      "action": "store",
      "help": "seed for synthetic data generation",
      "ui_exposed": true
    },
    {
      "name": "fraction_evaluate",
      "type": "float",
      "optional": true,
      "default": 1.0,
      "flag": "--fraction-evaluate",
      "short_flag": "--fraction-evaluate",
      "action": "store",
      "help": "fraction of clients used for evaluation",
      "ui_exposed": true
    },
    {
      "name": "json",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--json",
      "short_flag": "--json",
      "action": "store_true",
      "help": "==SUPPRESS==",
      "ui_exposed": true
    },
    {
      "name": "bastion_host",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--bastion-host",
      "short_flag": "--bastion-host",
      "action": "store",
      "help": "SSH bastion hostname for reverse tunneling",
      "ui_exposed": true
    },
    {
      "name": "bastion_user",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--bastion-user",
      "short_flag": "--bastion-user",
      "action": "store",
      "help": "SSH user on bastion",
      "ui_exposed": true
    },
    {
      "name": "bastion_port",
      "type": "int",
      "optional": true,
      "default": 22,
      "flag": "--bastion-port",
      "short_flag": "--bastion-port",
      "action": "store",
      "help": "SSH port on bastion",
      "ui_exposed": true
    },
    {
      "name": "bastion_key",
      "type": "str",
      "optional": true,
      "default": "id_ed25519",
      "flag": "--bastion-key",
      "short_flag": "--bastion-key",
      "action": "store",
      "help": "path to SSH private key inside container",
      "ui_exposed": true
    },
    {
      "name": "bastion_known_hosts",
      "type": "str",
      "optional": true,
      "default": "known_hosts",
      "flag": "--bastion-known-hosts",
      "short_flag": "--bastion-known-hosts",
      "action": "store",
      "help": "path to known_hosts file; if missing, host key checking is relaxed",
      "ui_exposed": true
    },
    {
      "name": "bastion_fleet_port",
      "type": "int",
      "optional": true,
      "default": 19092,
      "flag": "--bastion-fleet-port",
      "short_flag": "--bastion-fleet-port",
      "action": "store",
      "help": "remote port on bastion forwarding to Fleet API",
      "ui_exposed": true
    },
    {
      "name": "bastion_control_port",
      "type": "int",
      "optional": true,
      "default": 19093,
      "flag": "--bastion-control-port",
      "short_flag": "--bastion-control-port",
      "action": "store",
      "help": "remote port on bastion forwarding to Control API",
      "ui_exposed": true
    },
    {
      "name": "bastion_serverapp_port",
      "type": "int",
      "optional": true,
      "default": 19091,
      "flag": "--bastion-serverapp-port",
      "short_flag": "--bastion-serverapp-port",
      "action": "store",
      "help": "remote port on bastion forwarding to ServerAppIo",
      "ui_exposed": true
    }
  ]
}
