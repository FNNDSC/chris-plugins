{
  "name": "pl-lld_chxr",
  "version": "1.2.2",
  "dock_image": "ghcr.io/fnndsc/pl-lld_chxr:1.2.2",
  "public_repo": "https://github.com/fnndsc/pl-lld_chxr",
  "type": "ds",
  "title": "A ChRIS plugin to analyze the result produced by an LLD analysis",
  "category": "",
  "description": "A ChRIS plugin to analyze the result produced by an LLD analysis",
  "documentation": "https://github.com/FNNDSC/pl-lld_chxr#readme",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python3.14",
  "selfpath": "/usr/local/bin",
  "selfexec": "lld_chxr",
  "max_number_of_workers": 1,
  "min_cpu_limit": "4000m",
  "min_memory_limit": "1000Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "fileFilter",
      "type": "str",
      "optional": true,
      "default": "json",
      "flag": "--fileFilter",
      "short_flag": "-f",
      "action": "store",
      "help": "Input file filter glob",
      "ui_exposed": true
    },
    {
      "name": "measurementsUnit",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--measurementsUnit",
      "short_flag": "-m",
      "action": "store",
      "help": "Accepted unit for length measurements",
      "ui_exposed": true
    },
    {
      "name": "limbDifference",
      "type": "float",
      "optional": true,
      "default": 1.7976931348623157e+308,
      "flag": "--limbDifference",
      "short_flag": "-d",
      "action": "store",
      "help": "Accepted difference in both limbs",
      "ui_exposed": true
    },
    {
      "name": "tibiaDifference",
      "type": "float",
      "optional": true,
      "default": 1.7976931348623157e+308,
      "flag": "--tibiaDifference",
      "short_flag": "-b",
      "action": "store",
      "help": "Accepted tibia difference in both limbs",
      "ui_exposed": true
    },
    {
      "name": "femurDifference",
      "type": "float",
      "optional": true,
      "default": 1.7976931348623157e+308,
      "flag": "--femurDifference",
      "short_flag": "-r",
      "action": "store",
      "help": "Accepted femur difference in both limbs",
      "ui_exposed": true
    },
    {
      "name": "splitToken",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--splitToken",
      "short_flag": "-s",
      "action": "store",
      "help": "If specified, use this token to split the input tags.",
      "ui_exposed": true
    },
    {
      "name": "splitKeyValue",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--splitKeyValue",
      "short_flag": "-k",
      "action": "store",
      "help": "If specified, use this char to split key-value.",
      "ui_exposed": true
    },
    {
      "name": "tagInfo",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--tagInfo",
      "short_flag": "-t",
      "action": "store",
      "help": "Specify accepted tags and their values here.",
      "ui_exposed": true
    },
    {
      "name": "outputImageExtension",
      "type": "str",
      "optional": true,
      "default": "jpg",
      "flag": "--outputImageExtension",
      "short_flag": "--outputImageExtension",
      "action": "store",
      "help": "Generated output image file extension (default: jpg)",
      "ui_exposed": true
    },
    {
      "name": "addTextPos",
      "type": "str",
      "optional": true,
      "default": "top",
      "flag": "-q",
      "short_flag": "-q",
      "action": "store",
      "help": "Position of text placement on an input image; \"top\" or \"bottom\"",
      "ui_exposed": true
    },
    {
      "name": "addText",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--addText",
      "short_flag": "--addText",
      "action": "store",
      "help": "Optional text to add on the final image",
      "ui_exposed": true
    },
    {
      "name": "addTextSize",
      "type": "float",
      "optional": true,
      "default": 5.0,
      "flag": "--addTextSize",
      "short_flag": "--addTextSize",
      "action": "store",
      "help": "Size of additional text on the final output (default: 5)",
      "ui_exposed": true
    },
    {
      "name": "addTextColor",
      "type": "str",
      "optional": true,
      "default": "white",
      "flag": "--addTextColor",
      "short_flag": "--addTextColor",
      "action": "store",
      "help": "Color of additional text on the final output (default: white)",
      "ui_exposed": true
    },
    {
      "name": "addLineSpace",
      "type": "float",
      "optional": true,
      "default": 0.5,
      "flag": "--addLineSpace",
      "short_flag": "--addLineSpace",
      "action": "store",
      "help": "Line space in additional text on the final output, smaller = tighter (default: 0.5)",
      "ui_exposed": true
    }
  ]
}
