{
  "name": "pl-n4biasfieldcorrection",
  "version": "2.6.5.0",
  "dock_image": "ghcr.io/fnndsc/pl-n4biasfieldcorrection:2.6.5.0",
  "public_repo": "https://github.com/fnndsc/pl-n4biasfieldcorrection",
  "type": "ds",
  "title": "MRI Bias Field Correction (ANTs N4 Algorithm)",
  "category": "MRI",
  "description": "A ChRIS plugin wrapper for N4BiasFieldCorrection",
  "documentation": "https://github.com/FNNDSC/pl-N4BiasFieldCorrection",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python3.14",
  "selfpath": "/usr/local/bin",
  "selfexec": "n4wrapper",
  "max_number_of_workers": 1,
  "min_cpu_limit": "8000m",
  "min_memory_limit": "8192Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "shrink_factor",
      "type": "int",
      "optional": true,
      "default": 3,
      "flag": "--shrink-factor",
      "short_flag": "-s",
      "action": "store",
      "help": "Shrink factor",
      "ui_exposed": true
    },
    {
      "name": "convergence",
      "type": "str",
      "optional": true,
      "default": "[400x400x400,0.00]",
      "flag": "--convergence",
      "short_flag": "-c",
      "action": "store",
      "help": "",
      "ui_exposed": true
    },
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*.nii,**/*.nii.gz",
      "flag": "--pattern",
      "short_flag": "-p",
      "action": "store",
      "help": "Input file patterns",
      "ui_exposed": true
    },
    {
      "name": "required_success",
      "type": "int",
      "optional": true,
      "default": -1,
      "flag": "--required-success",
      "short_flag": "-q",
      "action": "store",
      "help": "Number of successful jobs required for exit code 0. Setting this parameter implies [0, N) jobs may fail. If unspecified, all jobs must be successful.",
      "ui_exposed": true
    },
    {
      "name": "threads",
      "type": "int",
      "optional": true,
      "default": -1,
      "flag": "--threads",
      "short_flag": "-J",
      "action": "store",
      "help": "Number of threads to use",
      "ui_exposed": true
    }
  ]
}
