{
  "name": "pl-lgd-hemis",
  "version": "1.0.0",
  "dock_image": "ghcr.io/fnndsc/pl-lgd-hemis:1.0.0",
  "public_repo": "https://github.com/FNNDSC/pl-lgd-hemis",
  "type": "ds",
  "title": "LGD WM Hemispheres",
  "category": "Surfaces",
  "description": "White-matter hemisphere extraction for the LGD project",
  "documentation": "https://github.com/FNNDSC/pl-lgd-hemis",
  "license": "MIT",
  "authors": "FNNDSC <Jennings.Zhang@childrens.harvard.edu>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "lgd_hemis",
  "max_number_of_workers": 1,
  "min_memory_limit": "500Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*seg*.mnc",
      "flag": "--pattern",
      "short_flag": "-p",
      "action": "store",
      "help": "input segmentation files glob",
      "ui_exposed": true
    }
  ]
}
