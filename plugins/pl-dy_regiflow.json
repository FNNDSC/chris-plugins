{
  "name": "pl-dy_regiflow",
  "version": "1.1.5",
  "dock_image": "ghcr.io/fnndsc/pl-dy_regiflow:1.1.5",
  "public_repo": "https://github.com/fnndsc/pl-dy_regiflow",
  "type": "ds",
  "title": "A dynamic registration workflow control plugin",
  "category": "",
  "description": "A dynamic ChRIS plugin to check PACS registration and control workflows",
  "documentation": "https://github.com/FNNDSC/pl-dy_regi",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "dy_regiFlow",
  "max_number_of_workers": 1,
  "min_memory_limit": "100Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "PACSurl",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--PACSurl",
      "short_flag": "--PACSurl",
      "action": "store",
      "help": "endpoint URL of pfdcm",
      "ui_exposed": true
    },
    {
      "name": "PACSname",
      "type": "str",
      "optional": true,
      "default": "MINICHRISORTHANC",
      "flag": "--PACSname",
      "short_flag": "--PACSname",
      "action": "store",
      "help": "name of the PACS",
      "ui_exposed": true
    },
    {
      "name": "CUBEurl",
      "type": "str",
      "optional": true,
      "default": "http://localhost:8000/api/v1/",
      "flag": "--CUBEurl",
      "short_flag": "--CUBEurl",
      "action": "store",
      "help": "CUBE URL",
      "ui_exposed": true
    },
    {
      "name": "pluginInstanceID",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--pluginInstanceID",
      "short_flag": "--pluginInstanceID",
      "action": "store",
      "help": "plugin instance ID from which to start analysis",
      "ui_exposed": true
    },
    {
      "name": "CUBEtoken",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--CUBEtoken",
      "short_flag": "--CUBEtoken",
      "action": "store",
      "help": "CUBE/ChRIS auth token",
      "ui_exposed": true
    },
    {
      "name": "inputJSONfile",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--inputJSONfile",
      "short_flag": "--inputJSONfile",
      "action": "store",
      "help": "JSON file containing DICOM data to be retrieved",
      "ui_exposed": true
    },
    {
      "name": "neuroDicomLocation",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--neuroDicomLocation",
      "short_flag": "--neuroDicomLocation",
      "action": "store",
      "help": "a location in the neuro tree for DICOM",
      "ui_exposed": true
    },
    {
      "name": "neuroAnonLocation",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--neuroAnonLocation",
      "short_flag": "--neuroAnonLocation",
      "action": "store",
      "help": "a location in the neuro tree for anon DICOM",
      "ui_exposed": true
    },
    {
      "name": "neuroNiftiLocation",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--neuroNiftiLocation",
      "short_flag": "--neuroNiftiLocation",
      "action": "store",
      "help": "a location in the neuro tree for nifti",
      "ui_exposed": true
    },
    {
      "name": "folderName",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--folderName",
      "short_flag": "--folderName",
      "action": "store",
      "help": "folder name in neuro tree to push analysis data",
      "ui_exposed": true
    },
    {
      "name": "pollInterval",
      "type": "int",
      "optional": true,
      "default": 5,
      "flag": "--pollInterval",
      "short_flag": "--pollInterval",
      "action": "store",
      "help": "wait time in seconds before the next poll",
      "ui_exposed": true
    },
    {
      "name": "maxPoll",
      "type": "int",
      "optional": true,
      "default": 50,
      "flag": "--maxPoll",
      "short_flag": "--maxPoll",
      "action": "store",
      "help": "max number of times to poll before error out",
      "ui_exposed": true
    },
    {
      "name": "largeSequenceSize",
      "type": "int",
      "optional": true,
      "default": 10000,
      "flag": "--largeSequenceSize",
      "short_flag": "--largeSequenceSize",
      "action": "store",
      "help": "sequence size that will be considered as large sequence for delayed polling",
      "ui_exposed": true
    },
    {
      "name": "largeSequencePollInterval",
      "type": "int",
      "optional": true,
      "default": 10,
      "flag": "--largeSequencePollInterval",
      "short_flag": "--largeSequencePollInterval",
      "action": "store",
      "help": "poll interval time for large sequences (in minutes)",
      "ui_exposed": true
    },
    {
      "name": "inNode",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--inNode",
      "short_flag": "--inNode",
      "action": "store_true",
      "help": "perform in-node implicit parallelization in conjunction with --thread",
      "ui_exposed": true
    },
    {
      "name": "thread",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--thread",
      "short_flag": "--thread",
      "action": "store_true",
      "help": "use threading to branch in parallel",
      "ui_exposed": true
    },
    {
      "name": "recipients",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--recipients",
      "short_flag": "--recipients",
      "action": "store",
      "help": "comma separated valid email recipient addresses",
      "ui_exposed": true
    },
    {
      "name": "SMTPServer",
      "type": "str",
      "optional": true,
      "default": "mailsmtp4.childrenshospital.org",
      "flag": "--SMTPServer",
      "short_flag": "--SMTPServer",
      "action": "store",
      "help": "valid email server",
      "ui_exposed": true
    }
  ]
}
