{
  "name": "ep-subdivide-mnc-methods",
  "version": "1.1.1",
  "dock_image": "ghcr.io/fnndsc/ep-subdivide-mnc-methods:1.1.1",
  "public_repo": "https://github.com/FNNDSC/ep-subdivide-mnc-methods",
  "type": "ds",
  "title": "Subdivide MINC Volume",
  "category": "MINC",
  "description": "Use either nibabel or mincreshape to subdivide a volumetric image in the MINC file format.",
  "documentation": "https://github.com/FNNDSC/ep-subdivide-mnc-methods",
  "license": "MIT",
  "authors": "Jennings Zhang <Jennings.Zhang@childrens.harvard.edu>",
  "execshell": "/opt/conda/bin/python3.10",
  "selfpath": "/opt/conda/bin",
  "selfexec": "subdivide",
  "max_number_of_workers": 1,
  "min_memory_limit": "1024Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*.mnc",
      "flag": "--pattern",
      "short_flag": "-p",
      "action": "store",
      "help": "input file glob",
      "ui_exposed": true
    },
    {
      "name": "divisions",
      "type": "int",
      "optional": true,
      "default": 2,
      "flag": "--divisions",
      "short_flag": "-d",
      "action": "store",
      "help": "number of cuts along voxel edge, valid values are powers of 2",
      "ui_exposed": true
    }
  ]
}
