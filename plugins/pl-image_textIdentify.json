{
  "name": "pl-image_textIdentify",
  "version": "0.2.3",
  "dock_image": "ghcr.io/fnndsc/pl-image_textidentify:0.2.3",
  "public_repo": "https://github.com/FNNDSC/pl-image_textIdentify",
  "type": "ds",
  "title": "My ChRIS plugin",
  "description": "A ChRIS DS plugin template",
  "documentation": "https://github.com/FNNDSC/python-chrisapp-template",
  "license": "MIT",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "image_textIdentify",
  "max_number_of_workers": 1,
  "min_memory_limit": "100Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "fileFilter",
      "type": "str",
      "optional": true,
      "default": "png",
      "flag": "--fileFilter",
      "short_flag": "-f",
      "action": "store",
      "help": "input file filter(only the extension)",
      "ui_exposed": true
    },
    {
      "name": "outputType",
      "type": "str",
      "optional": true,
      "default": "png",
      "flag": "--outputType",
      "short_flag": "-o",
      "action": "store",
      "help": "output file type(only the extension)",
      "ui_exposed": true
    },
    {
      "name": "removeAll",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--removeAll",
      "short_flag": "-r",
      "action": "store_true",
      "help": "Remove all texts from image using text recognition model",
      "ui_exposed": true
    }
  ]
}
