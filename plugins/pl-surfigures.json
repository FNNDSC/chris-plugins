{
  "name": "pl-surfigures",
  "version": "1.2.0",
  "dock_image": "ghcr.io/fnndsc/pl-surfigures:1.2.0",
  "public_repo": "https://github.com/FNNDSC/pl-surfigures",
  "type": "ds",
  "title": "MNI Surfaces Figures",
  "category": "Visualization",
  "description": "Create PNG figures of surfaces and vertex-wise data",
  "documentation": "https://github.com/FNNDSC/pl-surfigures",
  "license": "MIT",
  "authors": "Jennings Zhang <Jennings.Zhang@childrens.harvard.edu>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "surfigures",
  "max_number_of_workers": 1,
  "min_memory_limit": "500Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "suffix",
      "type": "str",
      "optional": true,
      "default": ".txt",
      "flag": "--suffix",
      "short_flag": "-s",
      "action": "store",
      "help": "file extension of vertex-wise data file inputs",
      "ui_exposed": true
    },
    {
      "name": "output",
      "type": "str",
      "optional": true,
      "default": "{}.png",
      "flag": "--output",
      "short_flag": "-o",
      "action": "store",
      "help": "output file template and file type. \"{}\" is replaced by the subject name.",
      "ui_exposed": true
    },
    {
      "name": "range",
      "type": "str",
      "optional": true,
      "default": ".disterr.txt:-2.0:2.0,.abs.disterr.txt:0.0:2.0,.smtherr.txt:0.0:2.0",
      "flag": "--range",
      "short_flag": "-r",
      "action": "store",
      "help": "Ranges for specific file extensions.",
      "ui_exposed": true
    },
    {
      "name": "min",
      "type": "str",
      "optional": true,
      "default": "0.0",
      "flag": "--min",
      "short_flag": "--min",
      "action": "store",
      "help": "Default range minimum value",
      "ui_exposed": true
    },
    {
      "name": "max",
      "type": "str",
      "optional": true,
      "default": "10.0",
      "flag": "--max",
      "short_flag": "--max",
      "action": "store",
      "help": "Default range maximum value",
      "ui_exposed": true
    },
    {
      "name": "background_color",
      "type": "str",
      "optional": true,
      "default": "white",
      "flag": "--background-color",
      "short_flag": "-b",
      "action": "store",
      "help": "Figure background color",
      "ui_exposed": true
    },
    {
      "name": "font_color",
      "type": "str",
      "optional": true,
      "default": "green",
      "flag": "--font-color",
      "short_flag": "-f",
      "action": "store",
      "help": "Figure labels font color",
      "ui_exposed": true
    },
    {
      "name": "color_map",
      "type": "str",
      "optional": true,
      "default": "spectral",
      "flag": "--color-map",
      "short_flag": "-c",
      "action": "store",
      "help": "color map to use for data value visualization",
      "ui_exposed": true
    }
  ]
}
