{
  "name": "pl-z2labelmap",
  "version": "2.4.3",
  "dock_image": "docker.io/fnndsc/pl-z2labelmap:latest",
  "public_repo": "https://github.com/FNNDSC/pl-z2labelmap",
  "type": "ds",
  "title": "z-score to FreeSurfer label map",
  "category": "FreeSurfer",
  "description": "Convert a file of per-structure z-scores to a FreeSurfer labelmap.",
  "documentation": "http://wiki",
  "license": "Opensource (MIT)",
  "authors": "FNNDSC (dev@babyMRI.org)",
  "execshell": "python3",
  "selfpath": "/usr/src/z2labelmap",
  "selfexec": "z2labelmap.py",
  "max_number_of_workers": 1,
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "f_posRange",
      "type": "float",
      "optional": true,
      "default": 1.0,
      "flag": "--posRange",
      "short_flag": "-p",
      "action": "store",
      "help": "positive range for random max deviation generation",
      "ui_exposed": true
    },
    {
      "name": "posColor",
      "type": "str",
      "optional": true,
      "default": "R",
      "flag": "--posColor",
      "short_flag": "-P",
      "action": "store",
      "help": "Some combination of 'R', 'G', B' for positive heat",
      "ui_exposed": true
    },
    {
      "name": "f_negRange",
      "type": "float",
      "optional": true,
      "default": -1.0,
      "flag": "--negRange",
      "short_flag": "-n",
      "action": "store",
      "help": "negative range for random max deviation generation",
      "ui_exposed": true
    },
    {
      "name": "negColor",
      "type": "str",
      "optional": true,
      "default": "B",
      "flag": "--negColor",
      "short_flag": "-N",
      "action": "store",
      "help": "Some combination of 'R', 'G', B' for negative heat",
      "ui_exposed": true
    },
    {
      "name": "imageSet",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--imageSet",
      "short_flag": "-I",
      "action": "store",
      "help": "copy a pre-calculated image set to output",
      "ui_exposed": true
    },
    {
      "name": "f_scaleRange",
      "type": "float",
      "optional": true,
      "default": 0.0,
      "flag": "--scaleRange",
      "short_flag": "-s",
      "action": "store",
      "help": "scale range for normalization",
      "ui_exposed": true
    },
    {
      "name": "f_lowerFilter",
      "type": "float",
      "optional": true,
      "default": -1.0,
      "flag": "--lowerFilter",
      "short_flag": "-l",
      "action": "store",
      "help": "filter all z-scores below (normalized) <lowerFilter> to 0.0",
      "ui_exposed": true
    },
    {
      "name": "f_upperFilter",
      "type": "float",
      "optional": true,
      "default": -1.0,
      "flag": "--upperFilter",
      "short_flag": "-u",
      "action": "store",
      "help": "filter all z-scores above (normalized) <upperFilter> to 0.0",
      "ui_exposed": true
    },
    {
      "name": "zFile",
      "type": "str",
      "optional": true,
      "default": "zfile.csv",
      "flag": "--zFile",
      "short_flag": "-z",
      "action": "store",
      "help": "z-score file to read (relative to input directory)",
      "ui_exposed": true
    },
    {
      "name": "b_random",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--random",
      "short_flag": "--random",
      "action": "store_true",
      "help": "if specified, generate a z-score file",
      "ui_exposed": true
    },
    {
      "name": "seed",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--seed",
      "short_flag": "-d",
      "action": "store",
      "help": "random number seed",
      "ui_exposed": true
    }
  ]
}
