{
  "name": "pl-dylld",
  "version": "4.4.45",
  "dock_image": "ghcr.io/fnndsc/pl-dylld:4.4.45",
  "public_repo": "https://github.com/fnndsc/pl-dylld",
  "type": "ds",
  "title": "Leg-Length Discrepency - Dynamic Compute Flow",
  "category": "",
  "description": "A ChRIS plugin that dynamically builds a workflow to compute length discrepencies from extremity X-Rays",
  "documentation": "https://github.com/rudolphpienaar/pl-dylld",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <rudolph.pienaar@childrens.harvard.edu>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "dylld",
  "max_number_of_workers": 1,
  "min_memory_limit": "100Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*dcm",
      "flag": "--pattern",
      "short_flag": "--pattern",
      "action": "store",
      "help": "pattern for file names to include (you should quote this!)\n            (this flag triggers the PathMapper on the inputdir).",
      "ui_exposed": true
    },
    {
      "name": "pluginInstanceID",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--pluginInstanceID",
      "short_flag": "--pluginInstanceID",
      "action": "store",
      "help": "plugin instance ID from which to start analysis",
      "ui_exposed": true
    },
    {
      "name": "CUBEurl",
      "type": "str",
      "optional": true,
      "default": "http://localhost:8000/api/v1/",
      "flag": "--CUBEurl",
      "short_flag": "--CUBEurl",
      "action": "store",
      "help": "CUBE URL",
      "ui_exposed": true
    },
    {
      "name": "CUBEuser",
      "type": "str",
      "optional": true,
      "default": "chris",
      "flag": "--CUBEuser",
      "short_flag": "--CUBEuser",
      "action": "store",
      "help": "CUBE/ChRIS username",
      "ui_exposed": true
    },
    {
      "name": "CUBEpassword",
      "type": "str",
      "optional": true,
      "default": "chris1234",
      "flag": "--CUBEpassword",
      "short_flag": "--CUBEpassword",
      "action": "store",
      "help": "CUBE/ChRIS password",
      "ui_exposed": true
    },
    {
      "name": "orthancURL",
      "type": "str",
      "optional": true,
      "default": "https://orthanc-chris-public.apps.ocp-prod.massopen.cloud/",
      "flag": "--orthancURL",
      "short_flag": "--orthancURL",
      "action": "store",
      "help": "IP of the orthanc to receive analysis results",
      "ui_exposed": true
    },
    {
      "name": "orthancuser",
      "type": "str",
      "optional": true,
      "default": "fnndsc",
      "flag": "--orthancuser",
      "short_flag": "--orthancuser",
      "action": "store",
      "help": "Orthanc username",
      "ui_exposed": true
    },
    {
      "name": "orthancpassword",
      "type": "str",
      "optional": true,
      "default": "Lerkyacyids5",
      "flag": "--orthancpassword",
      "short_flag": "--orthancpassword",
      "action": "store",
      "help": "Orthanc password",
      "ui_exposed": true
    },
    {
      "name": "orthancremote",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--orthancremote",
      "short_flag": "--orthancremote",
      "action": "store",
      "help": "remote orthanc modality",
      "ui_exposed": true
    },
    {
      "name": "verbosity",
      "type": "str",
      "optional": true,
      "default": "0",
      "flag": "--verbosity",
      "short_flag": "--verbosity",
      "action": "store",
      "help": "verbosity level of app",
      "ui_exposed": true
    },
    {
      "name": "thread",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--thread",
      "short_flag": "--thread",
      "action": "store_true",
      "help": "use threading to branch in parallel",
      "ui_exposed": true
    },
    {
      "name": "pftelDB",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--pftelDB",
      "short_flag": "--pftelDB",
      "action": "store",
      "help": "an optional pftel telemetry logger, of form '<pftelURL>/api/v1/<object>/<collection>/<event>'",
      "ui_exposed": true
    },
    {
      "name": "inNode",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--inNode",
      "short_flag": "--inNode",
      "action": "store_true",
      "help": "perform in-node implicit parallelization in conjunction with --thread",
      "ui_exposed": true
    },
    {
      "name": "notimeout",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--notimeout",
      "short_flag": "--notimeout",
      "action": "store_true",
      "help": "if specified, then controller never timesout while waiting on nodes to complete",
      "ui_exposed": true
    },
    {
      "name": "debug",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--debug",
      "short_flag": "--debug",
      "action": "store_true",
      "help": "if true, toggle telnet pudb debugging",
      "ui_exposed": true
    },
    {
      "name": "debugTermSize",
      "type": "str",
      "optional": true,
      "default": "253,62",
      "flag": "--debugTermSize",
      "short_flag": "--debugTermSize",
      "action": "store",
      "help": "the terminal 'cols,rows' size for debugging",
      "ui_exposed": true
    },
    {
      "name": "debugPort",
      "type": "str",
      "optional": true,
      "default": "7900",
      "flag": "--debugPort",
      "short_flag": "--debugPort",
      "action": "store",
      "help": "the debugging telnet port",
      "ui_exposed": true
    },
    {
      "name": "debugHost",
      "type": "str",
      "optional": true,
      "default": "0.0.0.0",
      "flag": "--debugHost",
      "short_flag": "--debugHost",
      "action": "store",
      "help": "the debugging telnet host",
      "ui_exposed": true
    }
  ]
}
