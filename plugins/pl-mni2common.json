{
  "name": "pl-mni2common",
  "version": "1.1.0",
  "dock_image": "ghcr.io/fnndsc/pl-mni2common:1.1.0",
  "public_repo": "https://github.com/fnndsc/pl-mni2common",
  "type": "ds",
  "title": "MINC and OBJ File Format Converter",
  "category": "MRI",
  "description": "A ChRIS plugin to convert MINC volume and MNI .obj surface file formats to NIFTI and MZ3 OBJ respectively.",
  "documentation": "https://github.com/FNNDSC/pl-mni2common",
  "license": "MIT",
  "authors": "FNNDSC <jennings.zhang@childrens.harvard.edu>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "mni2common",
  "max_number_of_workers": 1,
  "min_memory_limit": "512Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*",
      "flag": "--pattern",
      "short_flag": "-p",
      "action": "store",
      "help": "Path filter",
      "ui_exposed": true
    },
    {
      "name": "threads",
      "type": "int",
      "optional": true,
      "default": -1,
      "flag": "--threads",
      "short_flag": "-J",
      "action": "store",
      "help": "Number of threads to use",
      "ui_exposed": true
    }
  ]
}
