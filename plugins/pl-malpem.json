{
  "name": "pl-malpem",
  "version": "1.3.0",
  "dock_image": "ghcr.io/fnndsc/pl-malpem:1.3.0",
  "public_repo": "https://github.com/fnndsc/pl-malpem",
  "type": "ds",
  "title": "MALPEM Brain Segmentation",
  "description": "Brain MRI bias correction, extraction, and segmentation pipeline",
  "documentation": "https://github.com/FNNDSC/pl-malpem",
  "license": "MIT",
  "authors": "Christian Ledig, BioMedIA, & FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "malpem_chris_wrapper",
  "max_number_of_workers": 1,
  "min_cpu_limit": "8000m",
  "min_memory_limit": "12288Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "field_strength",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--field_strength",
      "short_flag": "-f",
      "action": "store",
      "help": "field strength, 1.5T/3T",
      "ui_exposed": true
    },
    {
      "name": "cleanup",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--cleanup",
      "short_flag": "-c",
      "action": "store_true",
      "help": "delete temporary files and atlas deformation fields",
      "ui_exposed": true
    },
    {
      "name": "threads",
      "type": "int",
      "optional": true,
      "default": 4,
      "flag": "--threads",
      "short_flag": "-t",
      "action": "store",
      "help": "maximum number of parallel threads",
      "ui_exposed": true
    }
  ]
}
