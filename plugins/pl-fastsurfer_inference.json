{
  "name": "pl-fastsurfer_inference",
  "version": "1.4.0",
  "dock_image": "ghcr.io/fnndsc/pl-fastsurfer_inference:1.4.0",
  "public_repo": "https://github.com/fnndsc/pl-fastsurfer_inference",
  "type": "ds",
  "title": "An app to efficiently perform cortical parcellation and segmentation on raw brain MRI images",
  "description": "An app to efficiently perform cortical parcellation and segmentation on raw brain MRI images",
  "documentation": "http://wiki",
  "license": "MIT",
  "authors": "Martin Reuter (FastSurfer), Sandip Samal (FNNDSC) (sandip.samal@childrens.harvard.edu) <dev@babyMRI.org>",
  "execshell": "/venv/bin/python",
  "selfpath": "/venv/bin",
  "selfexec": "fastsurfer_inference",
  "max_number_of_workers": 1,
  "min_cpu_limit": "16000m",
  "min_memory_limit": "16384Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "fs_license",
      "type": "str",
      "optional": true,
      "default": "/fastsurfer/fs_license.txt",
      "flag": "--fs_license",
      "short_flag": "--fs_license",
      "action": "store",
      "help": " Path to FreeSurfer license key file.",
      "ui_exposed": true
    },
    {
      "name": "t1",
      "type": "str",
      "optional": true,
      "default": "brain.mgz",
      "flag": "--t1",
      "short_flag": "--t1",
      "action": "store",
      "help": "name of the input (raw) file to process (default: brain.mgz)",
      "ui_exposed": true
    },
    {
      "name": "sid",
      "type": "str",
      "optional": true,
      "default": "subject-000",
      "flag": "--sid",
      "short_flag": "--sid",
      "action": "store",
      "help": "Subject ID for directory inside output dir to be created",
      "ui_exposed": true
    },
    {
      "name": "seg",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--seg",
      "short_flag": "--seg",
      "action": "store",
      "help": "Path to segmented file inside inputdir",
      "ui_exposed": true
    },
    {
      "name": "clean_seg",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--clean_seg",
      "short_flag": "--clean_seg",
      "action": "store_true",
      "help": "if specified, clean up segmentation",
      "ui_exposed": true
    },
    {
      "name": "no_cuda",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--no_cuda",
      "short_flag": "--no_cuda",
      "action": "store_true",
      "help": "if specified, do not use GPU",
      "ui_exposed": true
    },
    {
      "name": "batch",
      "type": "str",
      "optional": true,
      "default": "8",
      "flag": "--batch",
      "short_flag": "--batch",
      "action": "store",
      "help": "batch size for inference (default: 8",
      "ui_exposed": true
    },
    {
      "name": "simple_run",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--simple_run",
      "short_flag": "--simple_run",
      "action": "store_true",
      "help": "simplified run: only analyze one subject",
      "ui_exposed": true
    },
    {
      "name": "parallel",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--parallel",
      "short_flag": "--parallel",
      "action": "store_true",
      "help": "Run both hemispheres in parallel",
      "ui_exposed": true
    },
    {
      "name": "seg_only",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--seg_only",
      "short_flag": "--seg_only",
      "action": "store_true",
      "help": "Run only FastSurferCNN (generate segmentation, do not run surface pipeline)",
      "ui_exposed": true
    },
    {
      "name": "surf_only",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--surf_only",
      "short_flag": "--surf_only",
      "action": "store_true",
      "help": "Run surface pipeline only. The segmentation input has to exist already in this case.",
      "ui_exposed": true
    },
    {
      "name": "seg_with_cc_only",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--seg_with_cc_only",
      "short_flag": "--seg_with_cc_only",
      "action": "store_true",
      "help": " Run FastSurferCNN (generate segmentation) and recon_surf until corpus callosum (CC) is added in (no surface models will be created in this case!)",
      "ui_exposed": true
    },
    {
      "name": "pftelDB",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--pftelDB",
      "short_flag": "--pftelDB",
      "action": "store",
      "help": "optional pftel server DB path",
      "ui_exposed": true
    }
  ]
}
