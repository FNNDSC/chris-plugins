{
  "name": "pl-markimg",
  "version": "1.6.6",
  "dock_image": "ghcr.io/fnndsc/pl-markimg:1.6.6",
  "public_repo": "https://github.com/FNNDSC/pl-markimg",
  "type": "ds",
  "title": "An app to mark landmark points and lines on an input image",
  "category": "",
  "description": "An app to mark landmark points and lines on an input image",
  "documentation": "https://github.com/FNNDSC/pl-markimg#readme",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "markimg",
  "max_number_of_workers": 1,
  "min_cpu_limit": "2000m",
  "min_memory_limit": "8000Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "inputJsonName",
      "type": "str",
      "optional": true,
      "default": "prediction.json",
      "flag": "--inputJsonName",
      "short_flag": "-j",
      "action": "store",
      "help": "Input JSON file name",
      "ui_exposed": true
    },
    {
      "name": "inputImageName",
      "type": "str",
      "optional": true,
      "default": "leg.png",
      "flag": "--inputImageName",
      "short_flag": "-i",
      "action": "store",
      "help": "Name of the input image file",
      "ui_exposed": true
    },
    {
      "name": "pointMarker",
      "type": "str",
      "optional": true,
      "default": "x",
      "flag": "--pointMarker",
      "short_flag": "-p",
      "action": "store",
      "help": "Point marker",
      "ui_exposed": true
    },
    {
      "name": "pointColor",
      "type": "str",
      "optional": true,
      "default": "red",
      "flag": "--pointColor",
      "short_flag": "-c",
      "action": "store",
      "help": "Color of point marker",
      "ui_exposed": true
    },
    {
      "name": "lineColor",
      "type": "str",
      "optional": true,
      "default": "red",
      "flag": "--lineColor",
      "short_flag": "-l",
      "action": "store",
      "help": "Color of the line to be drawn",
      "ui_exposed": true
    },
    {
      "name": "textColor",
      "type": "str",
      "optional": true,
      "default": "white",
      "flag": "--textColor",
      "short_flag": "-t",
      "action": "store",
      "help": "Color of text",
      "ui_exposed": true
    },
    {
      "name": "textSize",
      "type": "float",
      "optional": true,
      "default": 5.0,
      "flag": "--textSize",
      "short_flag": "-s",
      "action": "store",
      "help": "Size of the text displayed on image",
      "ui_exposed": true
    },
    {
      "name": "linewidth",
      "type": "float",
      "optional": true,
      "default": 1.0,
      "flag": "--linewidth",
      "short_flag": "-w",
      "action": "store",
      "help": "Width of lines on image",
      "ui_exposed": true
    },
    {
      "name": "textPos",
      "type": "str",
      "optional": true,
      "default": "right",
      "flag": "--textPos",
      "short_flag": "-q",
      "action": "store",
      "help": "Position of text placement on an input image; left or right",
      "ui_exposed": true
    },
    {
      "name": "lineGap",
      "type": "int",
      "optional": true,
      "default": 20,
      "flag": "--lineGap",
      "short_flag": "-g",
      "action": "store",
      "help": "Space between lines in pixels",
      "ui_exposed": true
    },
    {
      "name": "pointSize",
      "type": "int",
      "optional": true,
      "default": 10,
      "flag": "--pointSize",
      "short_flag": "-z",
      "action": "store",
      "help": "The size of points to be plotted on the image",
      "ui_exposed": true
    },
    {
      "name": "pftelDB",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--pftelDB",
      "short_flag": "--pftelDB",
      "action": "store",
      "help": "optional pftel server DB path",
      "ui_exposed": true
    },
    {
      "name": "addText",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--addText",
      "short_flag": "--addText",
      "action": "store",
      "help": "optional text to add on the final image",
      "ui_exposed": true
    },
    {
      "name": "addTextPos",
      "type": "str",
      "optional": true,
      "default": "right",
      "flag": "--addTextPos",
      "short_flag": "--addTextPos",
      "action": "store",
      "help": "Position of additional text on the final output,the available choices are top, bottom, left, right and across",
      "ui_exposed": true
    },
    {
      "name": "addTextSize",
      "type": "float",
      "optional": true,
      "default": 5.0,
      "flag": "--addTextSize",
      "short_flag": "--addTextSize",
      "action": "store",
      "help": "Size of additional text on the final output,default value is 5",
      "ui_exposed": true
    },
    {
      "name": "addTextColor",
      "type": "str",
      "optional": true,
      "default": "white",
      "flag": "--addTextColor",
      "short_flag": "--addTextColor",
      "action": "store",
      "help": "Color of additional text on the final output,default value is white",
      "ui_exposed": true
    },
    {
      "name": "addTextOffset",
      "type": "str",
      "optional": true,
      "default": "0,0",
      "flag": "--addTextOffset",
      "short_flag": "--addTextOffset",
      "action": "store",
      "help": "Offset of additional text on the final output,default value is 0,0",
      "ui_exposed": true
    },
    {
      "name": "outputImageExtension",
      "type": "str",
      "optional": true,
      "default": "jpg",
      "flag": "--outputImageExtension",
      "short_flag": "--outputImageExtension",
      "action": "store",
      "help": "Generated output image file extension,default value is jpg",
      "ui_exposed": true
    }
  ]
}
