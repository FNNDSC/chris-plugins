{
  "name": "pl-pfdo_med2img",
  "version": "1.2.2",
  "dock_image": "fnndsc/pl-pfdo_med2img:1.2.2",
  "public_repo": "https://github.com/FNNDSC/pl-pfdo_med2img",
  "type": "ds",
  "title": "A ChRIS plugin app",
  "category": "",
  "description": "An app to recursively walk down a directory tree and perform bulk med2image on files/dirs.",
  "documentation": "http://wiki",
  "license": "MIT",
  "icon": "",
  "authors": "Arushi Vyas <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "pfdo_med2img",
  "max_number_of_workers": 1,
  "min_memory_limit": "2048Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "inputFile",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--inputFile",
      "short_flag": "-i",
      "action": "store",
      "help": "input file",
      "ui_exposed": true
    },
    {
      "name": "fileFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--fileFilter",
      "short_flag": "--fileFilter",
      "action": "store",
      "help": "a list of comma separated string filters to apply across the input file space",
      "ui_exposed": true
    },
    {
      "name": "dirFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--dirFilter",
      "short_flag": "--dirFilter",
      "action": "store",
      "help": "a list of comma separated string filters to apply across the input dir space",
      "ui_exposed": true
    },
    {
      "name": "analyzeFileIndex",
      "type": "str",
      "optional": true,
      "default": "-1",
      "flag": "--analyzeFileIndex",
      "short_flag": "--analyzeFileIndex",
      "action": "store",
      "help": "file index per directory to analyze",
      "ui_exposed": true
    },
    {
      "name": "printElapsedTime",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--printElapsedTime",
      "short_flag": "--printElapsedTime",
      "action": "store_true",
      "help": "print program run time",
      "ui_exposed": true
    },
    {
      "name": "threads",
      "type": "str",
      "optional": true,
      "default": "0",
      "flag": "--threads",
      "short_flag": "--threads",
      "action": "store",
      "help": "number of threads for innermost loop processing",
      "ui_exposed": true
    },
    {
      "name": "outputLeafDir",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--outputLeafDir",
      "short_flag": "--outputLeafDir",
      "action": "store",
      "help": "formatting spec for output leaf directory",
      "ui_exposed": true
    },
    {
      "name": "test",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--test",
      "short_flag": "--test",
      "action": "store_true",
      "help": "test",
      "ui_exposed": true
    },
    {
      "name": "synopsis",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--synopsis",
      "short_flag": "-y",
      "action": "store_true",
      "help": "short synopsis",
      "ui_exposed": true
    },
    {
      "name": "overwrite",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--overwrite",
      "short_flag": "--overwrite",
      "action": "store_true",
      "help": "overwrite files if already existing",
      "ui_exposed": true
    },
    {
      "name": "followLinks",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--followLinks",
      "short_flag": "--followLinks",
      "action": "store_true",
      "help": "follow symbolic links",
      "ui_exposed": true
    },
    {
      "name": "verbose",
      "type": "str",
      "optional": true,
      "default": "1",
      "flag": "--verbose",
      "short_flag": "--verbose",
      "action": "store",
      "help": "verbosity level for app",
      "ui_exposed": true
    },
    {
      "name": "inputFileSubStr",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--inputFileSubStr",
      "short_flag": "--inputFileSubStr",
      "action": "store",
      "help": "input file substring",
      "ui_exposed": true
    },
    {
      "name": "outputFileStem",
      "type": "str",
      "optional": true,
      "default": "output.jpg",
      "flag": "--outputFileStem",
      "short_flag": "-o",
      "action": "store",
      "help": "output file",
      "ui_exposed": true
    },
    {
      "name": "outputFileType",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--outputFileType",
      "short_flag": "-t",
      "action": "store",
      "help": "output image type",
      "ui_exposed": true
    },
    {
      "name": "convertOnlySingleDICOM",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--convertOnlySingleDICOM",
      "short_flag": "--convertOnlySingleDICOM",
      "action": "store_true",
      "help": "if specified, only convert the specific input DICOM",
      "ui_exposed": true
    },
    {
      "name": "preserveDICOMinputName",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--preserveDICOMinputName",
      "short_flag": "--preserveDICOMinputName",
      "action": "store_true",
      "help": "if specified, save output files with the basename of their input DICOM",
      "ui_exposed": true
    },
    {
      "name": "sliceToConvert",
      "type": "str",
      "optional": true,
      "default": "-1",
      "flag": "--sliceToConvert",
      "short_flag": "-s",
      "action": "store",
      "help": "slice to convert (for 3D data)",
      "ui_exposed": true
    },
    {
      "name": "frameToConvert",
      "type": "str",
      "optional": true,
      "default": "-1",
      "flag": "--frameToConvert",
      "short_flag": "-f",
      "action": "store",
      "help": "frame to convert (for 4D data)",
      "ui_exposed": true
    },
    {
      "name": "reslice",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--reslice",
      "short_flag": "-r",
      "action": "store_true",
      "help": "save images along i,j,k directions -- 3D input only",
      "ui_exposed": true
    },
    {
      "name": "showSlices",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--showSlices",
      "short_flag": "--showSlices",
      "action": "store_true",
      "help": "show slices that are converted",
      "ui_exposed": true
    },
    {
      "name": "func",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--func",
      "short_flag": "--func",
      "action": "store",
      "help": "apply transformation function before saving",
      "ui_exposed": true
    },
    {
      "name": "rot",
      "type": "str",
      "optional": true,
      "default": "110",
      "flag": "--rot",
      "short_flag": "--rot",
      "action": "store",
      "help": "3D slice/dimenstion rotation vector",
      "ui_exposed": true
    },
    {
      "name": "rotAngle",
      "type": "str",
      "optional": true,
      "default": "90",
      "flag": "--rotAngle",
      "short_flag": "--rotAngle",
      "action": "store",
      "help": "3D slice/dimenstion rotation angle",
      "ui_exposed": true
    }
  ]
}
