{
  "name": "pl-pfdo_med2img",
  "version": "1.2.2",
  "dock_image": "fnndsc/pl-pfdo_med2img:1.2.2",
  "public_repo": "https://github.com/FNNDSC/pl-pfdo_med2img",
  "type": "ds",
  "title": "A ChRIS plugin app",
  "category": "",
  "description": "An app to recursively walk down a directory tree and perform bulk med2image on files/dirs.",
  "documentation": "http://wiki",
  "license": "MIT",
  "icon": "",
  "authors": "Arushi Vyas <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "pfdo_med2img",
  "max_number_of_workers": 1,
  "min_memory_limit": "2048Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "fileFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--fileFilter",
      "short_flag": "--fileFilter",
      "action": "store",
      "help": "a list of comma separated string filters to apply across the input file space",
      "ui_exposed": true
    },
    {
      "name": "dirFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--dirFilter",
      "short_flag": "--dirFilter",
      "action": "store",
      "help": "a list of comma separated string filters to apply across the input dir space",
      "ui_exposed": true
    },
    {
      "name": "analyzeFileIndex",
      "type": "str",
      "optional": true,
      "default": "-1",
      "flag": "--analyzeFileIndex",
      "short_flag": "--analyzeFileIndex",
      "action": "store",
      "help": "file index per directory to analyze",
      "ui_exposed": true
    },
    {
      "name": "printElapsedTime",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--printElapsedTime",
      "short_flag": "--printElapsedTime",
      "action": "store_true",
      "help": "print program run time",
      "ui_exposed": true
    },
    {
      "name": "threads",
      "type": "str",
      "optional": true,
      "default": "0",
      "flag": "--threads",
      "short_flag": "--threads",
      "action": "store",
      "help": "number of threads for innermost loop processing",
      "ui_exposed": true
    },
    {
      "name": "outputLeafDir",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--outputLeafDir",
      "short_flag": "--outputLeafDir",
      "action": "store",
      "help": "formatting spec for output leaf directory",
      "ui_exposed": true
    },
    {
      "name": "test",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--test",
      "short_flag": "--test",
      "action": "store_true",
      "help": "test",
      "ui_exposed": true
    },
    {
      "name": "synopsis",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--synopsis",
      "short_flag": "-y",
      "action": "store_true",
      "help": "short synopsis",
      "ui_exposed": true
    },
    {
      "name": "overwrite",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--overwrite",
      "short_flag": "--overwrite",
      "action": "store_true",
      "help": "overwrite files if already existing",
      "ui_exposed": true
    },
    {
      "name": "inputFile",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--inputFile",
      "short_flag": "-i",
      "action": "store",
      "help": "input file",
      "ui_exposed": true
    }
  ]
}
