{
  "name": "pl-pfdicom_tagextract",
  "version": "3.2.2",
  "dock_image": "ghcr.io/fnndsc/pl-pfdicom_tagextract:3.2.2",
  "public_repo": "https://github.com/FNNDSC/pl-pfdicom_tagextract",
  "type": "ds",
  "title": "A DICOM tag extractor/reporting tool. Generates reports based on DICOM header information.",
  "category": "DICOM",
  "description": "This app performs a recursive walk down an input tree, and for each location with a DICOM file, will generate a report in the corresponding location in the output tree.",
  "documentation": "https://github.com/FNNDSC/pfdicom_tagExtract",
  "license": "MIT",
  "icon": "",
  "authors": "Sandip Samal <sandip.samal@childrens.harvard.edu>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "dcm_tagExtract",
  "max_number_of_workers": 1,
  "min_cpu_limit": "2000m",
  "min_memory_limit": "2000Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "inputFile",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--inputFile",
      "short_flag": "-i",
      "action": "store",
      "help": "input file",
      "ui_exposed": true
    },
    {
      "name": "fileFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--fileFilter",
      "short_flag": "-e",
      "action": "store",
      "help": "DICOM file extension",
      "ui_exposed": true
    },
    {
      "name": "fileFilterLogic",
      "type": "str",
      "optional": true,
      "default": "OR",
      "flag": "--fileFilterLogic",
      "short_flag": "--fileFilterLogic",
      "action": "store",
      "help": "the logic to apply across the file filter",
      "ui_exposed": true
    },
    {
      "name": "dirFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--dirFilter",
      "short_flag": "-d",
      "action": "store",
      "help": "a list of comma separated string filters to apply across the input dir space",
      "ui_exposed": true
    },
    {
      "name": "dirFilterLogic",
      "type": "str",
      "optional": true,
      "default": "OR",
      "flag": "--dirFilterLogic",
      "short_flag": "--dirFilterLogic",
      "action": "store",
      "help": "the logic to apply across the dir filter",
      "ui_exposed": true
    },
    {
      "name": "tagFile",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--tagFile",
      "short_flag": "-F",
      "action": "store",
      "help": "file containing tags to parse",
      "ui_exposed": true
    },
    {
      "name": "tagList",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--tagList",
      "short_flag": "-T",
      "action": "store",
      "help": "comma-separated tag list",
      "ui_exposed": true
    },
    {
      "name": "rawType",
      "type": "str",
      "optional": true,
      "default": "raw",
      "flag": "-r",
      "short_flag": "-r",
      "action": "store",
      "help": "display raw tags",
      "ui_exposed": true
    },
    {
      "name": "imageFile",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--imageFile",
      "short_flag": "-m",
      "action": "store",
      "help": "image file to convert DICOM input",
      "ui_exposed": true
    },
    {
      "name": "syslog",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--syslog",
      "short_flag": "--syslog",
      "action": "store_true",
      "help": "show outputs in syslog style",
      "ui_exposed": true
    },
    {
      "name": "imageScale",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--imageScale",
      "short_flag": "-s",
      "action": "store",
      "help": "scale images with factor and optional :interpolation",
      "ui_exposed": true
    },
    {
      "name": "outputFileStem",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--outputFileStem",
      "short_flag": "-o",
      "action": "store",
      "help": "output file",
      "ui_exposed": true
    },
    {
      "name": "outputFileType",
      "type": "str",
      "optional": true,
      "default": "raw",
      "flag": "--outputFileType",
      "short_flag": "-t",
      "action": "store",
      "help": "list of output report types",
      "ui_exposed": true
    },
    {
      "name": "printElapsedTime",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--printElapsedTime",
      "short_flag": "--printElapsedTime",
      "action": "store_true",
      "help": "print program run time",
      "ui_exposed": true
    },
    {
      "name": "useIndexhtml",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--useIndexhtml",
      "short_flag": "--useIndexhtml",
      "action": "store_true",
      "help": "force html file to be called 'index.html'",
      "ui_exposed": true
    },
    {
      "name": "printToScreen",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--printToScreen",
      "short_flag": "-p",
      "action": "store_true",
      "help": "print output to screen",
      "ui_exposed": true
    },
    {
      "name": "synopsis",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--synopsis",
      "short_flag": "-y",
      "action": "store_true",
      "help": "short synopsis",
      "ui_exposed": true
    },
    {
      "name": "threads",
      "type": "str",
      "optional": true,
      "default": "0",
      "flag": "--threads",
      "short_flag": "--threads",
      "action": "store",
      "help": "number of threads for innermost loop processing",
      "ui_exposed": true
    },
    {
      "name": "outputLeafDir",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--outputLeafDir",
      "short_flag": "--outputLeafDir",
      "action": "store",
      "help": "formatting spec for output leaf directory",
      "ui_exposed": true
    },
    {
      "name": "followLinks",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--followLinks",
      "short_flag": "--followLinks",
      "action": "store_true",
      "help": "follow symbolic links",
      "ui_exposed": true
    },
    {
      "name": "jsonReturn",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--jsonReturn",
      "short_flag": "--jsonReturn",
      "action": "store_true",
      "help": "output final return in json",
      "ui_exposed": true
    }
  ]
}
