{
  "name": "pl-dicom_info",
  "version": "1.0.29",
  "dock_image": "ghcr.io/fnndsc/pl-dicom_info:1.0.29",
  "public_repo": "https://github.com/FNNDSC/pl-dicom_info",
  "type": "ds",
  "title": "Report on DICOM Tag Information",
  "category": "",
  "description": "A ChRIS DS plugin that generates various reports based on the tag information in a DICOM file.",
  "documentation": "https://github.com/FNNDSC/pl-dicom_info",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "dicom_info",
  "max_number_of_workers": 1,
  "min_memory_limit": "2048Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "maxDepth",
      "type": "str",
      "optional": true,
      "default": "-1",
      "flag": "--maxDepth",
      "short_flag": "--maxDepth",
      "action": "store",
      "help": "max depth, counting from zero, to descend",
      "ui_exposed": true
    },
    {
      "name": "inputFile",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--inputFile",
      "short_flag": "--inputFile",
      "action": "store",
      "help": "input file",
      "ui_exposed": true
    },
    {
      "name": "man",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--man",
      "short_flag": "--man",
      "action": "store_true",
      "help": "man",
