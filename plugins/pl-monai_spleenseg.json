{
  "name": "pl-monai_spleenseg",
  "version": "1.2.52",
  "dock_image": "ghcr.io/fnndsc/pl-monai_spleenseg:1.2.52",
  "public_repo": "https://github.com/fnndsc/pl-monai_spleenseg",
  "type": "ds",
  "title": "Spleen 3D image segmentation (MONAI)",
  "category": "",
  "description": "A ChRIS DS plugin heavily hacked off project MONAI's spleen segmenation notebook",
  "documentation": "https://github.com/FNNDSC/pl-monai_spleenseg",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "spleenseg",
  "max_number_of_workers": 1,
  "min_cpu_limit": "2000m",
  "min_memory_limit": "24576Mi",
  "min_gpu_limit": 1,
  "max_gpu_limit": 2,
  "parameters": [
    {
      "name": "JSONargString",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--JSONargs",
      "short_flag": "--JSONargs",
      "action": "store",
      "help": "JSON equivalent of CLI key/values",
      "ui_exposed": true
    },
    {
      "name": "man",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--man",
      "short_flag": "--man",
      "action": "store_true",
      "help": "If specified, print a manual page",
      "ui_exposed": true
    },
    {
      "name": "mode",
      "type": "str",
      "optional": true,
      "default": "training",
      "flag": "--mode",
      "short_flag": "--mode",
      "action": "store",
      "help": "mode of behaviour: 'training', 'inference' or <remote>",
      "ui_exposed": true
    },
    {
      "name": "logTransformVols",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--logTransformVols",
      "short_flag": "--logTransformVols",
      "action": "store_true",
      "help": "If specified, save intermediary and inference data as NIfTI volumes",
      "ui_exposed": true
    },
    {
      "name": "useModel",
      "type": "str",
      "optional": true,
      "default": "model.pth",
      "flag": "--useModel",
      "short_flag": "--useModel",
      "action": "store",
      "help": "model to use for inference processing",
      "ui_exposed": true
    },
    {
      "name": "trainImageDir",
      "type": "str",
      "optional": true,
      "default": "imagesTr",
      "flag": "--trainImageDir",
      "short_flag": "--trainImageDir",
      "action": "store",
      "help": "name of directory containing training images",
      "ui_exposed": true
    },
    {
      "name": "trainLabelsDir",
      "type": "str",
      "optional": true,
      "default": "labelsTr",
      "flag": "--trainLabelsDir",
      "short_flag": "--trainLabelsDir",
      "action": "store",
      "help": "name of directory containing training labels",
      "ui_exposed": true
    },
    {
      "name": "testImageDir",
      "type": "str",
      "optional": true,
      "default": "imagesTs",
      "flag": "--testImageDir",
      "short_flag": "--testImageDir",
      "action": "store",
      "help": "name of directory containing test data",
      "ui_exposed": true
    },
    {
      "name": "device",
      "type": "str",
      "optional": true,
      "default": "cpu",
      "flag": "--device",
      "short_flag": "--device",
      "action": "store",
      "help": "GPU/CPU device to use",
      "ui_exposed": true
    },
    {
      "name": "determinismSeed",
      "type": "int",
      "optional": true,
      "default": 42,
      "flag": "--determinismSeed",
      "short_flag": "--determinismSeed",
      "action": "store",
      "help": "the determinism seed for training/evaluation",
      "ui_exposed": true
    },
    {
      "name": "maxEpochs",
      "type": "int",
      "optional": true,
      "default": 600,
      "flag": "--maxEpochs",
      "short_flag": "--maxEpochs",
      "action": "store",
      "help": "max number of epochs to consider",
      "ui_exposed": true
    },
    {
      "name": "validateSize",
      "type": "int",
      "optional": true,
      "default": 9,
      "flag": "--validateSize",
      "short_flag": "--validateSize",
      "action": "store",
      "help": "size of the validation set in the input raw/label space",
      "ui_exposed": true
    },
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/[!._]*nii.gz",
      "flag": "--pattern",
      "short_flag": "--pattern",
      "action": "store",
      "help": "filter glob for input files",
      "ui_exposed": true
    }
  ]
}
