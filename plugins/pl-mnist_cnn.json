{
  "name": "pl-mnist_cnn",
  "version": "1.0.0",
  "dock_image": "ghcr.io/fnndsc/pl-mnist_cnn:1.0.0",
  "public_repo": "https://github.com/FNNDSC/pl-mnist_cnn",
  "type": "ds",
  "title": "MNIST digit classifier (small CNN): train, evaluate, predict",
  "category": "Machine Learning",
  "description": "Train, evaluate, or predict with a small CNN on MNIST handwritten digits.",
  "documentation": "https://github.com/FNNDSC/pl-mnist_cnn",
  "license": "MIT",
  "icon": "",
  "authors": "David Edelist <jedelist@bu.edu>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "mnist_cnn",
  "max_number_of_workers": 1,
  "min_memory_limit": "2Gi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "mode",
      "type": "str",
      "optional": false,
      "default": null,
      "flag": "--mode",
      "short_flag": "--mode",
      "action": "store",
      "help": "what to do: train a model, evaluate one on the MNIST test set, or predict the digit in each input image [choices: train, eval, predict]",
      "ui_exposed": true
    },
    {
      "name": "epochs",
      "type": "int",
      "optional": true,
      "default": 3,
      "flag": "--epochs",
      "short_flag": "--epochs",
      "action": "store",
      "help": "number of training epochs",
      "ui_exposed": true
    },
    {
      "name": "batch_size",
      "type": "int",
      "optional": true,
      "default": 128,
      "flag": "--batch-size",
      "short_flag": "--batch-size",
      "action": "store",
      "help": "batch size",
      "ui_exposed": true
    },
    {
      "name": "lr",
      "type": "float",
      "optional": true,
      "default": 0.001,
      "flag": "--lr",
      "short_flag": "--lr",
      "action": "store",
      "help": "learning rate",
      "ui_exposed": true
    },
    {
      "name": "seed",
      "type": "int",
      "optional": true,
      "default": 1337,
      "flag": "--seed",
      "short_flag": "--seed",
      "action": "store",
      "help": "random seed",
      "ui_exposed": true
    },
    {
      "name": "num_workers",
      "type": "int",
      "optional": true,
      "default": 2,
      "flag": "--num-workers",
      "short_flag": "--num-workers",
      "action": "store",
      "help": "data loader worker processes; 0 loads in the main process",
      "ui_exposed": true
    },
    {
      "name": "device",
      "type": "str",
      "optional": true,
      "default": "auto",
      "flag": "--device",
      "short_flag": "--device",
      "action": "store",
      "help": "where to compute [choices: auto, cpu, cuda, mps]",
      "ui_exposed": true
    },
    {
      "name": "amp",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--amp",
      "short_flag": "--amp",
      "action": "store_true",
      "help": "train with mixed precision; has an effect on a CUDA device only",
      "ui_exposed": true
    },
    {
      "name": "weight_decay",
      "type": "float",
      "optional": true,
      "default": 0.0,
      "flag": "--weight-decay",
      "short_flag": "--weight-decay",
      "action": "store",
      "help": "weight decay",
      "ui_exposed": true
    },
    {
      "name": "weights",
      "type": "str",
      "optional": true,
      "default": "best.ckpt",
      "flag": "--weights",
      "short_flag": "--weights",
      "action": "store",
      "help": "checkpoint to load; a relative path is under the input directory",
      "ui_exposed": true
    },
    {
      "name": "image",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--image",
      "short_flag": "--image",
      "action": "store",
      "help": "predict this one image; a relative path is under the input directory. Without it, every image matching --pattern is predicted",
      "ui_exposed": true
    },
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*.png",
      "flag": "--pattern",
      "short_flag": "--pattern",
      "action": "store",
      "help": "glob, under the input directory, of the images to predict when --image is not given",
      "ui_exposed": true
    },
    {
      "name": "suffix",
      "type": "str",
      "optional": true,
      "default": ".pred.txt",
      "flag": "--suffix",
      "short_flag": "--suffix",
      "action": "store",
      "help": "suffix of the per-image result files written in batch prediction",
      "ui_exposed": true
    }
  ]
}
