{
  "name": "pl-surfacecurv",
  "version": "1.0.0",
  "dock_image": "docker.io/fnndsc/pl-surfacecurv:latest",
  "public_repo": "https://github.com/fnndsc/pl-surfacecurv",
  "type": "ds",
  "title": "pl-surfaceCurv",
  "description": "A ChRIS DS plugin to process a brain surface mesh and analyze curvature",
  "documentation": "https://github.com/FNNDSC/pl-surfaceCurv",
  "license": "MIT",
  "authors": "FNNDSC <dev@fnndsc.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "surfaceCurv",
  "max_number_of_workers": 1,
  "min_memory_limit": "100Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "word",
      "type": "str",
      "optional": false,
      "default": null,
      "flag": "--word",
      "short_flag": "-w",
      "action": "store",
      "help": "word to count",
      "ui_exposed": true
    },
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*.txt",
      "flag": "--pattern",
      "short_flag": "-p",
      "action": "store",
      "help": "input file filter glob",
      "ui_exposed": true
    }
  ]
}
