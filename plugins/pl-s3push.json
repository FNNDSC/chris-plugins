{
  "name": "pl-s3push",
  "version": "0.1.2",
  "dock_image": "ghcr.io/fnndsc/pl-s3push:0.1.2",
  "public_repo": "https://github.com/FNNDSC/pl-s3push",
  "type": "ds",
  "title": "S3 Push",
  "description": "An app to push data of interest to Amazon S3 service",
  "documentation": "http://wiki",
  "license": "Opensource (MIT)",
  "authors": "FNNDSC (dev@babyMRI.org)",
  "execshell": "python3",
  "selfpath": "/usr/src/s3push",
  "selfexec": "s3push.py",
  "max_number_of_workers": 1,
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "bucket",
      "type": "str",
      "optional": false,
      "default": null,
      "flag": "--bucket",
      "short_flag": "--bucket",
      "action": "store",
      "help": "name of the Amazon S3 bucket",
      "ui_exposed": true
    },
    {
      "name": "prefix",
      "type": "str",
      "optional": false,
      "default": null,
      "flag": "--prefix",
      "short_flag": "--prefix",
      "action": "store",
      "help": "prefix string to be added to the s3 objects key",
      "ui_exposed": true
    },
    {
      "name": "awskeyid",
      "type": "str",
      "optional": false,
      "default": null,
      "flag": "--awskeyid",
      "short_flag": "--awskeyid",
      "action": "store",
      "help": "aws access key id",
      "ui_exposed": true
    },
    {
      "name": "awssecretkey",
      "type": "str",
      "optional": false,
      "default": null,
      "flag": "--awssecretkey",
      "short_flag": "--awssecretkey",
      "action": "store",
      "help": "aws secret access key",
      "ui_exposed": true
    }
  ]
}
