{
  "name": "pl-brainmri_preprocessed",
  "version": "0.1",
  "dock_image": "docker.io/fnndsc/pl-brainmri_preprocessed:latest",
  "public_repo": "https://github.com/FNNDSC/pl-brainmri_preprocessed",
  "type": "ds",
  "title": "A ChRIS plugin that contains all the preprocessed output of different plug-ins inside the GE workflow",
  "description": "A app to demonstrate the various results of GE pipeline",
  "documentation": "http://wiki",
  "license": "Opensource (MIT)",
  "authors": "Sandip Samal (sandip.samal@childrens.harvard.edu)",
  "execshell": "python3",
  "selfpath": "/usr/src/brainmri_preprocessed",
  "selfexec": "brainmri_preprocessed.py",
  "max_number_of_workers": 1,
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "treePrint",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--treePrint",
      "short_flag": "-T",
      "action": "store",
      "help": "Simple dirtree print. Specify head of target tree",
      "ui_exposed": true
    },
    {
      "name": "copySpec",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--copySpec",
      "short_flag": "-c",
      "action": "store",
      "help": "A comma separated string denoting the subdirs to copy",
      "ui_exposed": true
    },
    {
      "name": "processDelay",
      "type": "str",
      "optional": true,
      "default": "0",
      "flag": "--processDelay",
      "short_flag": "-P",
      "action": "store",
      "help": "delay timer to simulate remote processing",
      "ui_exposed": true
    },
    {
      "name": "jsonReturn",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--jsonReturn",
      "short_flag": "--jsonReturn",
      "action": "store_true",
      "help": "output final return in json",
      "ui_exposed": true
    }
  ]
}
