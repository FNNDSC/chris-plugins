{
  "name": "pl-dymap",
  "version": "2.1.2",
  "dock_image": "ghcr.io/fnndsc/pl-dymap:2.1.2",
  "public_repo": "https://github.com/fnndsc/pl-dymap",
  "type": "ds",
  "title": "Map a plugin or pipeline over the directories of the input: one child per item",
  "category": "Utility",
  "description": "Map a ChRIS pipeline over the directories of an input: one workflow per item, a ChRIS DS plugin",
  "documentation": "https://github.com/FNNDSC/pl-dymap",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python3.12",
  "selfpath": "/usr/local/bin",
  "selfexec": "dymap",
  "max_number_of_workers": 1,
  "min_cpu_limit": "500m",
  "min_memory_limit": "100Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "plugin",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--plugin",
      "short_flag": "--plugin",
      "action": "store",
      "help": "plugin each item gets, name or name@version",
      "ui_exposed": true
    },
    {
      "name": "pipeline",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--pipeline",
      "short_flag": "--pipeline",
      "action": "store",
      "help": "exact name of the pipeline each item gets",
      "ui_exposed": true
    },
    {
      "name": "itemPiping",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--itemPiping",
      "short_flag": "--itemPiping",
      "action": "store",
      "help": "title of the piping that receives the item",
      "ui_exposed": true
    },
    {
      "name": "itemParam",
      "type": "str",
      "optional": true,
      "default": "dirFilter",
      "flag": "--itemParam",
      "short_flag": "--itemParam",
      "action": "store",
      "help": "parameter set to the item",
      "ui_exposed": true
    },
    {
      "name": "itemTemplate",
      "type": "str",
      "optional": true,
      "default": "re:^{itemRegex}$",
      "flag": "--itemTemplate",
      "short_flag": "--itemTemplate",
      "action": "store",
      "help": "the item's value: {item} is its path, {itemRegex} the path escaped for a regex",
      "ui_exposed": true
    },
    {
      "name": "params",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--params",
      "short_flag": "--params",
      "action": "store",
      "help": "JSON of further values for every child",
      "ui_exposed": true
    },
    {
      "name": "itemFileFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--itemFileFilter",
      "short_flag": "--itemFileFilter",
      "action": "store",
      "help": "an item holds a file passing this filter",
      "ui_exposed": true
    },
    {
      "name": "itemFileFilterLogic",
      "type": "str",
      "optional": true,
      "default": "OR",
      "flag": "--itemFileFilterLogic",
      "short_flag": "--itemFileFilterLogic",
      "action": "store",
      "help": "AND or OR, how its tokens combine",
      "ui_exposed": true
    },
    {
      "name": "itemDirFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--itemDirFilter",
      "short_flag": "--itemDirFilter",
      "action": "store",
      "help": "an item's path passes this filter",
      "ui_exposed": true
    },
    {
      "name": "itemDirFilterLogic",
      "type": "str",
      "optional": true,
      "default": "OR",
      "flag": "--itemDirFilterLogic",
      "short_flag": "--itemDirFilterLogic",
      "action": "store",
      "help": "AND or OR, how its tokens combine",
      "ui_exposed": true
    },
    {
      "name": "itemDepth",
      "type": "int",
      "optional": true,
      "default": 0,
      "flag": "--itemDepth",
      "short_flag": "--itemDepth",
      "action": "store",
      "help": "depth of the items; 0 for the default",
      "ui_exposed": true
    },
    {
      "name": "maxItems",
      "type": "int",
      "optional": true,
      "default": 100,
      "flag": "--maxItems",
      "short_flag": "--maxItems",
      "action": "store",
      "help": "refuse an input with more items than this",
      "ui_exposed": true
    },
    {
      "name": "dryRun",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--dryRun",
      "short_flag": "--dryRun",
      "action": "store_true",
      "help": "write the plan, create nothing",
      "ui_exposed": true
    },
    {
      "name": "CUBEurl",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--CUBEurl",
      "short_flag": "--CUBEurl",
      "action": "store",
      "help": "CUBE API root as reachable from the job; or CHRIS_URL",
      "ui_exposed": true
    },
    {
      "name": "verbosity",
      "type": "int",
      "optional": true,
      "default": 1,
      "flag": "--verbosity",
      "short_flag": "--verbosity",
      "action": "store",
      "help": "0 silences the console",
      "ui_exposed": true
    },
    {
      "name": "man",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--man",
      "short_flag": "--man",
      "action": "store_true",
      "help": "print the full manual",
      "ui_exposed": true
    },
    {
      "name": "synopsis",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--synopsis",
      "short_flag": "--synopsis",
      "action": "store_true",
      "help": "print the manual's synopsis",
      "ui_exposed": true
    }
  ]
}
