{
  "name": "pl-bichamfer",
  "version": "1.0.1",
  "dock_image": "ghcr.io/fnndsc/pl-bichamfer:1.0.1",
  "public_repo": "https://github.com/FNNDSC/pl-bichamfer",
  "type": "ds",
  "title": "Radial Distance Map",
  "category": "MRI Processing",
  "description": "Bi-directional mincchamfer",
  "documentation": "https://github.com/FNNDSC/pl-bichamfer",
  "license": "MIT",
  "authors": "Jennings Zhang <Jennings.Zhang@childrens.harvard.edu>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "bichamfer",
  "max_number_of_workers": 1,
  "min_memory_limit": "1024Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*.mnc",
      "flag": "--pattern",
      "short_flag": "-p",
      "action": "store",
      "help": "input file filter glob",
      "ui_exposed": true
    },
    {
      "name": "boundary",
      "type": "float",
      "optional": true,
      "default": 10.0,
      "flag": "--boundary",
      "short_flag": "-b",
      "action": "store",
      "help": "boundary distance 0 value",
      "ui_exposed": true
    }
  ]
}
