{
  "name": "pl-dypxflow",
  "version": "1.1.8",
  "dock_image": "ghcr.io/fnndsc/pl-dypxflow:1.1.8",
  "public_repo": "https://github.com/fnndsc/pl-dypxflow",
  "type": "ds",
  "title": "A dynamic ChRIS plugin for PACS",
  "category": "",
  "description": "A dynamic ChRIS plugin to control PACS related workflows in CUBE",
  "documentation": "https://github.com/FNNDSC/pl-dypxFlow",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "dypxFlow",
  "max_number_of_workers": 1,
  "min_memory_limit": "100Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "pattern",
      "type": "str",
      "optional": true,
      "default": "**/*csv",
      "flag": "--pattern",
      "short_flag": "--pattern",
      "action": "store",
      "help": "pattern for file names to include.\n            Default is **/*csv.",
      "ui_exposed": true
    },
    {
      "name": "pluginInstanceID",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--pluginInstanceID",
      "short_flag": "--pluginInstanceID",
      "action": "store",
      "help": "plugin instance ID from which to start analysis",
      "ui_exposed": true
    },
    {
      "name": "CUBEurl",
      "type": "str",
      "optional": true,
      "default": "http://localhost:8000/api/v1/",
      "flag": "--CUBEurl",
      "short_flag": "--CUBEurl",
      "action": "store",
      "help": "CUBE URL. Please include api version in the url endpoint.",
      "ui_exposed": true
    },
    {
      "name": "CUBEtoken",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--CUBEtoken",
      "short_flag": "--CUBEtoken",
      "action": "store",
      "help": "CUBE/ChRIS user token",
      "ui_exposed": true
    },
    {
      "name": "maxThreads",
      "type": "int",
      "optional": true,
      "default": 4,
      "flag": "--maxThreads",
      "short_flag": "--maxThreads",
      "action": "store",
      "help": "max number of parallel threads",
      "ui_exposed": true
    },
    {
      "name": "thread",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--thread",
      "short_flag": "--thread",
      "action": "store_true",
      "help": "use threading to branch in parallel",
      "ui_exposed": true
    },
    {
      "name": "wait",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--wait",
      "short_flag": "--wait",
      "action": "store_true",
      "help": "wait for nodes to reach finished state",
      "ui_exposed": true
    },
    {
      "name": "PFDCMurl",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--PFDCMurl",
      "short_flag": "--PFDCMurl",
      "action": "store",
      "help": "endpoint URL of pfdcm. Please include api version in the url endpoint.",
      "ui_exposed": true
    },
    {
      "name": "PACSname",
      "type": "str",
      "optional": true,
      "default": "MINICHRISORTHANC",
      "flag": "--PACSname",
      "short_flag": "--PACSname",
      "action": "store",
      "help": "name of the PACS",
      "ui_exposed": true
    },
    {
      "name": "recipients",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--recipients",
      "short_flag": "--recipients",
      "action": "store",
      "help": "comma separated valid email recipient addresses",
      "ui_exposed": true
    },
    {
      "name": "SMTPServer",
      "type": "str",
      "optional": true,
      "default": "mailsmtp4.childrenshospital.org",
      "flag": "--SMTPServer",
      "short_flag": "--SMTPServer",
      "action": "store",
      "help": "valid email server",
      "ui_exposed": true
    },
    {
      "name": "largeSequenceSize",
      "type": "int",
      "optional": true,
      "default": 10000,
      "flag": "--largeSequenceSize",
      "short_flag": "--largeSequenceSize",
      "action": "store",
      "help": "sequence size that will be considered as large sequence for delayed polling",
      "ui_exposed": true
    },
    {
      "name": "largeSequencePollInterval",
      "type": "int",
      "optional": true,
      "default": 10,
      "flag": "--largeSequencePollInterval",
      "short_flag": "--largeSequencePollInterval",
      "action": "store",
      "help": "poll interval time for large sequences (in minutes)",
      "ui_exposed": true
    }
  ]
}
