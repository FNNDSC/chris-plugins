{
  "name": "pl-dicom_repack",
  "version": "1.3.1",
  "dock_image": "ghcr.io/fnndsc/pl-dicom_repack:1.3.1",
  "public_repo": "https://github.com/fnndsc/pl-dicom_repack",
  "type": "ds",
  "title": "A DICOM repack plugin",
  "category": "",
  "description": "A ChRIS plugin to merge individual dicom slices into a single multiframe DICOM",
  "documentation": "https://github.com/FNNDSC/pl-dicom_repack",
  "license": "MIT",
  "icon": "",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "dicom_repack",
  "max_number_of_workers": 1,
  "min_cpu_limit": "2000m",
  "min_memory_limit": "2048Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "fileFilter",
      "type": "str",
      "optional": true,
      "default": "dcm",
      "flag": "--fileFilter",
      "short_flag": "-f",
      "action": "store",
      "help": "input file filter glob",
      "ui_exposed": true
    },
    {
      "name": "outputType",
      "type": "str",
      "optional": true,
      "default": "dcm",
      "flag": "--outputType",
      "short_flag": "-t",
      "action": "store",
      "help": "input file filter glob",
      "ui_exposed": true
    }
  ]
}
