{
  "name": "pl-pfdicom_tagSub",
  "version": "3.3.5",
  "dock_image": "ghcr.io/fnndsc/pl-pfdicom_tagsub:3.3.5",
  "public_repo": "https://github.com/FNNDSC/pl-pfdicom_tagSub",
  "type": "ds",
  "title": "Edits various specified DICOM tags",
  "category": "DICOM",
  "description": "This plugin wraps around pfdicom_tagSub and is used to edit the contents of user-specified DICOM tags.",
  "documentation": "https://github.com/FNNDSC/pl-pfdicom_tagSub",
  "license": "MIT",
  "icon": "",
  "authors": "Sandip Samal <sandip.samal@childrens.harvard.edu>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "dcm_tagSub",
  "max_number_of_workers": 1,
  "min_cpu_limit": "2000m",
  "min_memory_limit": "32000Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "inputFile",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--inputFile",
      "short_flag": "-i",
      "action": "store",
      "help": "input file",
      "ui_exposed": true
    },
    {
      "name": "fileFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--fileFilter",
      "short_flag": "-e",
      "action": "store",
      "help": "DICOM file extension",
      "ui_exposed": true
    },
    {
      "name": "fileFilterLogic",
      "type": "str",
      "optional": true,
      "default": "OR",
      "flag": "--fileFilterLogic",
      "short_flag": "--fileFilterLogic",
      "action": "store",
      "help": "the logic to apply across the file filter",
      "ui_exposed": true
    },
    {
      "name": "dirFilter",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--dirFilter",
      "short_flag": "-d",
      "action": "store",
      "help": "a list of comma separated string filters to apply across the input dir space",
      "ui_exposed": true
    },
    {
      "name": "dirFilterLogic",
      "type": "str",
      "optional": true,
      "default": "OR",
      "flag": "--dirFilterLogic",
      "short_flag": "--dirFilterLogic",
      "action": "store",
      "help": "the logic to apply across the dir filter",
      "ui_exposed": true
    },
    {
      "name": "syslog",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--syslog",
      "short_flag": "--syslog",
      "action": "store_true",
      "help": "show outputs in syslog style",
      "ui_exposed": true
    },
    {
      "name": "tagFile",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--tagFile",
      "short_flag": "-F",
      "action": "store",
      "help": "JSON formatted file containing tags to sub",
      "ui_exposed": true
    },
    {
      "name": "tagStruct",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--tagStruct",
      "short_flag": "-T",
      "action": "store",
      "help": "JSON formatted tag sub struct",
      "ui_exposed": true
    },
    {
      "name": "tagInfo",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--tagInfo",
      "short_flag": "-n",
      "action": "store",
      "help": "A custom delimited tag sub struct",
      "ui_exposed": true
    },
    {
      "name": "splitKeyValue",
      "type": "str",
      "optional": true,
      "default": ",",
      "flag": "--splitKeyValue",
      "short_flag": "-k",
      "action": "store",
      "help": "Expression on which to split the <key><value> pairs",
      "ui_exposed": true
    },
    {
      "name": "splitToken",
      "type": "str",
      "optional": true,
      "default": "++",
      "flag": "--splitToken",
      "short_flag": "-s",
      "action": "store",
      "help": "Expression on which to split the <delimited_tag_info>",
      "ui_exposed": true
    },
    {
      "name": "outputFileStem",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--outputFileStem",
      "short_flag": "-o",
      "action": "store",
      "help": "output file",
      "ui_exposed": true
    },
    {
      "name": "printElapsedTime",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--printElapsedTime",
      "short_flag": "--printElapsedTime",
      "action": "store_true",
      "help": "print program run time",
      "ui_exposed": true
    },
    {
      "name": "threads",
      "type": "str",
      "optional": true,
      "default": "0",
      "flag": "--threads",
      "short_flag": "--threads",
      "action": "store",
      "help": "number of threads for innermost loop processing",
      "ui_exposed": true
    },
    {
      "name": "outputLeafDir",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--outputLeafDir",
      "short_flag": "--outputLeafDir",
      "action": "store",
      "help": "formatting spec for output leaf directory",
      "ui_exposed": true
    },
    {
      "name": "synopsis",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--synopsis",
      "short_flag": "-y",
      "action": "store_true",
      "help": "short synopsis",
      "ui_exposed": true
    },
    {
      "name": "jsonReturn",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--jsonReturn",
      "short_flag": "--jsonReturn",
      "action": "store_true",
      "help": "output final return in json",
      "ui_exposed": true
    },
    {
      "name": "followLinks",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--followLinks",
      "short_flag": "--followLinks",
      "action": "store_true",
      "help": "follow symbolic links",
      "ui_exposed": true
    },
    {
      "name": "removePrivateTags",
      "type": "bool",
      "optional": true,
      "default": false,
      "flag": "--removePrivateTags",
      "short_flag": "--removePrivateTags",
      "action": "store_true",
      "help": "If specified, iteratively remove all the private elements",
      "ui_exposed": true
    }
  ]
}
