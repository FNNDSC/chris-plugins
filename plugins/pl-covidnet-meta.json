{
  "name": "pl-covidnet-meta",
  "version": "1.0.10",
  "dock_image": "ghcr.io/fnndsc/pl-covidnet-meta:1.0.10",
  "public_repo": "https://github.com/FNNDSC/pl-covidnet-meta",
  "type": "ds",
  "title": "COVIDnet-meta",
  "description": "A ChRIS plugin that analyzes an upstream COVID prediction.json file and, if COVID infection inferred, will exit with an exception. This has the effect of coloring the node red in the DAG representation.",
  "documentation": "https://github.com/FNNDSC/pl-covidnet-",
  "license": "MIT",
  "authors": "FNNDSC <dev@babyMRI.org>",
  "execshell": "/usr/local/bin/python",
  "selfpath": "/usr/local/bin",
  "selfexec": "covidnet_meta",
  "max_number_of_workers": 1,
  "min_memory_limit": "4096Mi",
  "max_gpu_limit": 0,
  "parameters": [
    {
      "name": "predictionGlob",
      "type": "str",
      "optional": true,
      "default": "**/prediction-default.json",
      "flag": "--predictionGlob",
      "short_flag": "-p",
      "action": "store",
      "help": "the upstream prediction file glob (for multiprediction)",
      "ui_exposed": true
    },
    {
      "name": "prediction",
      "type": "str",
      "optional": true,
      "default": "",
      "flag": "--prediction",
      "short_flag": "-P",
      "action": "store",
      "help": "single prediction file",
      "ui_exposed": true
    }
  ]
}
